      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasInclusionCriteria": [
      {
        "@value": "All children and adolescents (<20 years) who visited participating SwissPedHealth clinics (both inpatient and outpatient) during the study period"
      }
    ],

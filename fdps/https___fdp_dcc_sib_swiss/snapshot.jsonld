      },
      {
        "@value": "Cantonal data protection laws"
      }
    ],
    "http://purl.org/dc/terms/abstract": [
      {
        "@value": "SwissPedAntibio aims to establish and carry out on-going surveillance of antibiotic use in the paediatric inpatient population in Switzerland, using the infrastructure of the National Data Stream SwissPedHealth.The primary aims of antibiotic use surveillance are to assess performance indicators and identify targets for quality improvement of antimicrobial prescribing, to design targeted interventions in participating hospitals and to assess their effectiveness, and to support benchmarking."
      }
    ],
    "http://purl.org/dc/terms/accessRights": [
      {
        "@id": "http://fdp.dcc.sib.swiss/catalog/08d6b731-ddcc-520a-b869-83fedc93d4e6#accessRights"
      }
    ],

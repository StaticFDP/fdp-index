        "@value": "General Consent and consent waiver (art. 34 HRA)"
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasDataProvider": [
      {
        "@id": "_:nd4ad1ebd02bc446a85c2e0f03458ec47b2"
      },
      {

    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "The dataset contains drug plasma level data of busulfan and complementary clinical data of patients receiving busulfan-based conditioning regimens for stem cell transplantation. The data will be used in pharmacokinetic models to better understand the pharmacokinetics of this drug and therefore be able to optimise the dosage regimens for children."
      }
    ],

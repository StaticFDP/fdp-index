      }
    ]
  },
  {
    "@id": "https://biomedit.ch/rdf/sphn-resource/902f7c77-7e77-41c3-b1d4-046ab1b37681",
    "@type": [
      "http://www.w3.org/2006/vcard/ns#Individual"
    ],

      {
        "@value": "Myelodysplastic/Myeloproliferative Neoplasm Post Cytotoxic Therapy"
      }
    ]
  },
  {
    "@id": "http://fdp.dcc.sib.swiss/catalog/88f8fde4-aff4-5c05-919c-2edba893bcd7/metrics/5d27e854a9e78eb3f663331cd47cdc13",

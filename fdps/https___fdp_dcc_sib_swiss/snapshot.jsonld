      {
        "@id": "https://doi.org/10.1038/s41598-025-34778-7"
      },
      {
        "@id": "https://doi.org/10.1093/jamia/ocaf145"
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasRatioOfSexes": [
      {
        "@value": "0.94"
      }

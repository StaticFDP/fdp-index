        "@value": "Swiss Personalized Health Network (SPHN)"
      }
    ]
  },
  {
    "@id": "http://fdp.dcc.sib.swiss/distribution/ae07d423-49f6-5cb8-a234-0fed0b730219/metrics/5d27e854a9e78eb3f663331cd47cdc13",

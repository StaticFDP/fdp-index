    "http://purl.org/dc/terms/description": [
      {
        "@value": "The dataset contains drug plasma level data of fludarabine and complementary clinical data. The data will be used in pharmacokinetic models to better understand the pharmacokinetics of this drug and therefore be able to optimise dosage regimens."
      }

  {
    "@id": "http://fdp.dcc.sib.swiss/catalog/4c54f9a6-1351-524d-aa62-633a4d4ab9c9",
    "@type": [
      "http://www.w3.org/ns/dcat#Resource",
      "http://www.w3.org/ns/dcat#Catalog"
    ],
    "http://data.europa.eu/r5r/applicableLegislation": [
      {
        "@id": "https://www.fedlex.admin.ch/eli/cc/2013/617/de"
      },
      {
        "@id": "https://www.fedlex.admin.ch/eli/cc/2022/491/de"
      },
      {
        "@id": "https://www.fedlex.admin.ch/eli/cc/2013/642/de"
      }
    ],
    "http://purl.org/dc/terms/abstract": [
      {
        "@value": "The SwissPedGrowth dataset is a comprehensive collection of routinely gathered pediatric clinical data from participating Swiss children's hospitals. It includes anthropometric measurements (height, weight, head circumference), clinical parameters, and laboratory values obtained from both inpatient and outpatient visits. Data are collected from January 2017 to December 2025 and are enriched with socioeconomic information (Swiss-SEP) via linkages with federal datasets (Swiss National Cohort, FSO). This pseudonymized dataset - excluding patients who rejected general consent - aims to use multi-institutional pediatric EHR data from Switzerland (SwissPedHealth) and compare them internationally to assess the feasibility of retrieving anthropometric data from EHRs in Switzerland, investigate data quality and validity, and answer simple research questions."
      }
    ],
    "http://purl.org/dc/terms/accessRights": [
      {
        "@id": "http://fdp.dcc.sib.swiss/catalog/4c54f9a6-1351-524d-aa62-633a4d4ab9c9#accessRights"
      }
    ],
    "http://purl.org/dc/terms/conformsTo": [
      {
        "@id": "https://www.biomedit.ch/rdf/sphn-schema/sph/2024/1"
      },
      {
        "@id": "https://www.biomedit.ch/rdf/sphn-schema/sph/2025/1"

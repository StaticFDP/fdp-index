    "http://purl.org/dc/terms/description": [
      {
        "@value": "This is a combined dataset which contains clinical routine data for (a) SPAC participants via SPHN which was used to compare with manually collected data saved in the study database, to assess if routine healthcare data could supplement or replace traditional data collection methods, and for (b) children who visited the collaborating clinics in SPAC but did not participate in the study, which was used to compare with data from SPAC participants to evaluate the generalizability of the results from the SPAC cohort."
      }
    ],

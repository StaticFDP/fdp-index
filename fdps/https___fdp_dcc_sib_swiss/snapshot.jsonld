  {
    "@id": "_:n961f1104402448f9a2b61668b41a2275b1",
    "@type": [
      "http://xmlns.com/foaf/0.1/Agent"
    ],
    "http://xmlns.com/foaf/0.1/name": [
      {
        "@value": "Swiss Personalized Health Network (SPHN)"
      }
    ]
  },
  {
    "@id": "http://fdp.dcc.sib.swiss/catalog/86fb83e6-27ae-55f4-9b57-6fdeb97b719b#accessRights",
    "@type": [
      "http://purl.org/dc/terms/RightsStatement"
    ],

  {
    "@id": "https://biomedit.ch/rdf/sphn-resource/sphn-metacat-a07a466e-927c-4d3a-9ef3-fcbf8702975a",
    "@type": [
      "http://www.w3.org/2006/vcard/ns#Individual"
    ],

    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasDataUseRestriction": [
      {
        "@value": "Access is given by internal validation pursuant to institutional guidelines and processes and approval by the Data Access Body. A request can be made using the DKFonline form (exceptional) https://dolphin.dkfbasel.ch/contactform#en"

  {
    "@id": "_:n82b63ac8f82a4212a29b2b5cecdb1c02b1",
    "@type": [
      "http://xmlns.com/foaf/0.1/Agent"
    ],
    "http://xmlns.com/foaf/0.1/name": [
      {
        "@value": "Swiss Personalized Health Network (SPHN)"
      }
    ]
  },
  {
    "@id": "http://fdp.dcc.sib.swiss/dataset/6ba57f67-6ba0-5b93-952c-8a73ed17212f/metrics/5d27e854a9e78eb3f663331cd47cdc13",

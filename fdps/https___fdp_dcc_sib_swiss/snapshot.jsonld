      }
    ],
    "http://purl.org/dc/terms/alternative": [
      {
        "@value": "GoS-Pilot - VCF"
      }
    ],
    "http://purl.org/dc/terms/conformsTo": [
      {
        "@id": "http://fdp.dcc.sib.swiss/profile/2f08228e-1789-40f8-84cd-28e3288c3604"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@value": "This VCF dataset contains genomic variant calls derived from participants included in the Genome of Switzerland Pilot. It provides the processed variant-level representation of the sequenced genomes and supports downstream analyses of genetic diversity, allele frequencies, population structure, pharmacogenomic variation, and other clinically or biologically relevant genomic findings. The dataset is intended to enable research on genomic variation within the contemporary Swiss population while avoiding the need to work directly from raw sequencing reads."
      }
    ],

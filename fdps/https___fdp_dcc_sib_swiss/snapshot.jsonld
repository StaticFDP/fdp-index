      },
      {
        "@id": "https://www.biomedit.ch/rdf/sphn-schema/sph/2025/1"
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "http://fdp.dcc.sib.swiss/catalog/727823d9-ab9d-5440-8f0f-78d6d5cecdb0"

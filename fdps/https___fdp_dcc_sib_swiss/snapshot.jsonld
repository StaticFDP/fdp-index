      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasInclusionCriteria": [
      {
        "@value": "Male and female"
      },
      {
        "@value": "Patients who had a lung function test in a pediatric hospital & division Age < 20 years at admission"
      },
      {
        "@value": "Inclusion by Exception: If no GC was recorded initially, patients must be contacted retrospectively. We can include patients who do not respond within the six-week window, as well as those who are 'lost to follow-up' and cannot be reached"
      },
      {
        "@value": "In- and outpatients"
      },
      {
        "@value": "Policy for CHUV: Existing Consent: Patients who already signed the GC are included"
      }
    ],

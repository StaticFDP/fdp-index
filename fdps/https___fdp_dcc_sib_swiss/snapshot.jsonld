      {
        "@value": "Swiss Personalized Health Network (SPHN)"
      }
    ]
  },
  {
    "@id": "https://biomedit.ch/rdf/sphn-metacat/sphn/health-category/EHRD",
    "http://www.w3.org/2000/01/rdf-schema#label": [

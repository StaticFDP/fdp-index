        "@value": "Overall criteria: patients treated for multiple cancers"
      },
      {
        "@value": "Melanoma-specific criteria: Uveal melanoma (ICD-10 C69)"
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasFundingOrganization": [

    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasDataUseRestriction": [
      {
        "@value": "Currently restricted to the use within the consortium. Anyone considering reuse of data from the SPO-NDS project must comply with the SPO-NDS CA, in particular sections 6.1, 6.2. 6.4, 6.5 and 6.6."
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasExclusionCriteria": [
      {
        "@value": "Melanoma-specific criteria: Uveal melanoma (ICD-10 C69)"
      },
      {
        "@value": "Overall criteria: patients treated for multiple cancers"
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasFundingOrganization": [
      {
        "@id": "_:n677620a694b647b1bcc86c4863755d4cb9"
      },
      {
        "@id": "_:n677620a694b647b1bcc86c4863755d4cb8"
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasInclusionCriteria": [
      {
        "@value": "Melanoma-specific criteria: ICD-10 code C43 or diagnosis text contains 'melanoma|melanom|melanome', treated with anti-PD-1 based or anti-PDL-1 based therapies"
      },
      {
        "@value": "Overall criteria: age at first date (incidence datetime) of diagnosis older than 18 years, approval of general consent, treated within the UH, biopsy assessed by NGS, date of NGS on or after 1st of January 2015"
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasNumberOfPatients": [

    "http://purl.org/dc/terms/description": [
      {
        "@value": "The dataset comprises metabolomics data from samples collected during the retrospective phase (Phase 2) of the project. These samples were biobanked by the SwissPedHealth Lighthouse Project, and the Lighthouse team prepared the purified materials. Subsequently, the samples were sent to the Clinical Metabolomics Analysis Center (CMAC) for processing."
      }

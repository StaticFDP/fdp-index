    ],
    "http://xmlns.com/foaf/0.1/name": [
      {
        "@value": "Swiss Personalized Health Network (SPHN)"
      }
    ]
  },
  {
    "@id": "https://biomedit.ch/rdf/sphn-resource/2731040b-1153-42fe-8a6d-4ac4b459b93a",

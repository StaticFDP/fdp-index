      {
        "@value": "http://fdp.dcc.sib.swiss/fc6e936d-ad4b-5b21-b8a4-8c7826bbec99"
      }
    ],
    "http://purl.org/dc/terms/isPartOf": [
      {
        "@id": "http://fdp.dcc.sib.swiss"

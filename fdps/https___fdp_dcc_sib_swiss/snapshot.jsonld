    "http://purl.org/dc/terms/abstract": [
      {
        "@value": "The PREPP project aimed to demonstrate the value of integrating paediatric primary care data with the national SwissPedHealth hospital data stream. Operating in pilot sites in Bern, Basel, and Geneva, the project extracted and linked data from primary care databases to hospital Clinical Data Warehouses (CDWs). An essential precondition for linking data from different healthcare providers, was pseudonymising the data through a two-stage hashing process. The project consolidated datasets using existing SPHN infrastructure to provide integrated data for research and public health."
      }
    ],
    "http://purl.org/dc/terms/accessRights": [

      {
        "@value": "Swiss Personalized Health Network (SPHN)"
      }
    ]
  },
  {
    "@id": "http://fdp.dcc.sib.swiss/concept-availability/53629a74-b947-5a05-8f55-e028669ec1fc/metrics/5d27e854a9e78eb3f663331cd47cdc13",

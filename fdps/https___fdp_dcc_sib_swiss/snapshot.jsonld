    ],
    "http://semanticscience.org/resource/SIO_000628": [
      {
        "@id": "http://fdp.dcc.sib.swiss/catalog/b11dbf20-e08e-5bf1-a1e5-ba64457e17c0/metrics/445c0a70d1e214e545b261559e2842f4"

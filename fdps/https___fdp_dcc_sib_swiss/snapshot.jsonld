      }
    ]
  },
  {
    "@id": "http://fdp.dcc.sib.swiss/distribution/277573f3-c375-56ee-a368-a82295e03205/metrics/5d27e854a9e78eb3f663331cd47cdc13",
    "http://semanticscience.org/resource/SIO_000332": [
      {

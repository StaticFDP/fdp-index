      }
    ],
    "http://purl.org/dc/terms/abstract": [
      {
        "@value": "This project aims to leverage existing observational cohort data from multiple centres to improve clinical decision making in persons with neuromuscular disorders, including cerebral palsy and those toe walking. The SPHN infrastructure will be used to merge rich datasets from two pilot centres: the clinical gait analysis services at UKBB and HUG. From this unique combined dataset, the project will determine the best possible treatments to improve walking in persons with neuromuscular disorders, by determining the causal effect of treatments."
      }
    ],
    "http://purl.org/dc/terms/accessRights": [

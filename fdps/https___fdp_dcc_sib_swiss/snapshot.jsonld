  {
    "@id": "http://fdp.dcc.sib.swiss/catalog/da5b40b5-fc0b-5366-a522-103459001a83",
    "@type": [
      "http://www.w3.org/ns/dcat#Catalog",
      "http://www.w3.org/ns/dcat#Resource"
    ],
    "http://data.europa.eu/r5r/applicableLegislation": [
      {
        "@id": "https://www.fedlex.admin.ch/eli/cc/2013/642/de"
      },
      {
        "@value": "Cantonal data protection laws"
      },
      {
        "@id": "https://www.fedlex.admin.ch/eli/cc/2022/491/de"
      },
      {
        "@id": "https://www.fedlex.admin.ch/eli/cc/2013/617/de"
      }
    ],
    "http://purl.org/dc/terms/abstract": [
      {
        "@value": "The Swiss Paediatric Airway Cohort (SPAC) is an ongoing study that includes children seen at pediatric pulmonology clinics across Switzerland, where we collect questionnaires and clinical data from hospital records. However, manual collection of clinical data is time-consuming, and frequent updates are needed to track patients across multiple visits, increasing the risk of missing data. In the SPHN-SPAC project, we obtained clinical data for SPAC participants via SPHN and compared it with manually collected data to determine whether routine healthcare data could supplement or replace traditional data collection methods. Additionally, we obtained clinical information from children who visited the clinics but did not participate and compare it with the data from SPAC participants to evaluate the generalizability of the SPAC cohort results. Lastly, we aimed to leverage routine healthcare data to obtain complete longitudinal information, including test results (e.g., lung function) and healthcare utilization details (e.g., emergency visits, hospitalizations)."
      }
    ],
    "http://purl.org/dc/terms/accessRights": [
      {
        "@id": "http://publications.europa.eu/resource/authority/access-right/RESTRICTED"
      }

  {
    "@id": "http://fdp.dcc.sib.swiss/catalog/7e07ae22-580f-5bfb-8b71-151d525d6a4e",
    "@type": [
      "http://www.w3.org/ns/dcat#Resource",
      "http://www.w3.org/ns/dcat#Catalog"
    ],

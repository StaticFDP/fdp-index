  {
    "@id": "http://fdp.dcc.sib.swiss/catalog/86fb83e6-27ae-55f4-9b57-6fdeb97b719b",
    "@type": [
      "http://www.w3.org/ns/dcat#Catalog",
      "http://www.w3.org/ns/dcat#Resource"
    ],
    "http://data.europa.eu/r5r/applicableLegislation": [
      {
        "@id": "https://www.fedlex.admin.ch/eli/cc/2013/642/de"
      },
      {
        "@id": "https://www.fedlex.admin.ch/eli/cc/2013/617/de"
      },
      {
        "@id": "https://www.fedlex.admin.ch/eli/cc/2022/491/de"
      },
      {
        "@value": "Cantonal data protection laws"
      }
    ],
    "http://purl.org/dc/terms/abstract": [
      {
        "@value": "Due to the unique epidemiology, developmental changes, and high vulnerability of children, there is an urgent need to continuously improve health care based on real world pediatric data. The digital transformation is a unique opportunity to shape a data-driven, agile, learning health care system and deliver more efficient and personalized care to children and their families.  The goal of SwissPedHealth is to build a sustainable and scalable infrastructure to make routine clinical data from pediatric hospitals in Switzerland interoperable, standardized, quality-controlled, and ready for observational research, quality assurance, trials, and health-policy creation. SwissPedHealth is one of four National Data Streams co-funded by the Swiss Personalized Health Network (SPHN) and the ETH focus area Personalized Health Related Technologies (PHRT). SwissPedHealth develops modular governance and regulatory strategies in collaboration with clinical data warehouses, the Data Coordination Center, Biomedical Information Technology Network, and others."
      }
    ],
    "http://purl.org/dc/terms/accessRights": [
      {
        "@id": "http://publications.europa.eu/resource/authority/access-right/RESTRICTED"
      }
    ],
    "http://purl.org/dc/terms/conformsTo": [
      {
        "@id": "https://www.biomedit.ch/rdf/sphn-schema/sph/2025/1"
      },
      {
        "@id": "http://fdp.dcc.sib.swiss/profile/a0949e72-4466-4d53-8900-9436d1049a4b"
      },
      {
        "@id": "https://www.biomedit.ch/rdf/sphn-schema/sphn/2024/2"
      },
      {
        "@id": "https://www.biomedit.ch/rdf/sphn-schema/sphn/2025/1"
      }

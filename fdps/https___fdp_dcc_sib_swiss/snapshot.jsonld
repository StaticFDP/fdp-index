    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasDataUseRestriction": [
      {
        "@value": "Reuse conditions are regulated in the SPO Consortium Agreement and reuse is approved by the Consortium Executive Board. Third parties can apply for reuse."

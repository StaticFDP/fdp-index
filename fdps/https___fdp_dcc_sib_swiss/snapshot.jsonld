    "http://purl.org/dc/terms/description": [
      {
        "@value": "The dataset contains drug plasma level data of gentamicin, fludarabine and vancomycin and complementary clinical data. These data will be used in pharmacokinetic models to better understand the pharmacokinetics of these drugs and therefore be able to optimise the dosage regimens for children."
      }

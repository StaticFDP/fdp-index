      {
        "@id": "https://doi.org/10.21203/rs.3.rs-4594014/v1"
      },
      {
        "@id": "https://dx.doi.org/10.21203/rs.3.rs-6848278/v1"
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasRatioOfSexes": [

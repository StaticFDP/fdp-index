  {
    "@id": "http://fdp.dcc.sib.swiss/catalog/0cb87ed8-5159-53cf-b68e-639a9f95a443",
    "@type": [
      "http://www.w3.org/ns/dcat#Resource",
      "http://www.w3.org/ns/dcat#Catalog"
    ],
    "http://data.europa.eu/r5r/applicableLegislation": [
      {
        "@value": "Cantonal data protection laws"
      },
      {
        "@id": "https://www.fedlex.admin.ch/eli/cc/2013/617/de"
      },
      {
        "@id": "https://www.fedlex.admin.ch/eli/cc/2013/642/de"
      },
      {
        "@id": "https://www.fedlex.admin.ch/eli/cc/2022/491/de"
      }
    ],
    "http://purl.org/dc/terms/abstract": [
      {
        "@value": "In our previous SPHN infrastructure project SwissPKcdw, we successfully established a clinical data warehouse (CDW) to enhance access to clinical data of pediatric patients cared for at the University Children's Hospital Zurich (Kispi) and Basel (UKBB). We collected and pseudonymized drug plasma concentrations from routine drug monitoring together with the respective clinical information. These data were analyzed by population pharmacokinetic modelling to identify factors (e.g., age, weight, endogenous metabolites) which influence or correlate with the fate of a particular drug in the body. The resulting models allow to optimize and individualize drug dosage regimens. In the current demonstrator project, we aim to expand the previously built infrastructure to the remaining university children's hospitals in Switzerland. In addition to the drug plasma concentrations and clinical information we will include data on relevant genes involved in the metabolism of the drugs and on molecules that give information on chemical processes within the cells. These data will allow searching for additional endogenous metabolites with predictive potential for the pharmacokinetics of a drug in pediatric patients."
      }
    ],

        "@value": "1.0"
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasAgeRange": [
      {
        "@value": "0 - 113"
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasConsentType": [
      {

      },
      {
        "@id": "https://www.biomedit.ch/rdf/sphn-schema/sphn/2024/2"
      },
      {
        "@id": "https://www.biomedit.ch/rdf/sphn-schema/sph/2024/1"
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "http://fdp.dcc.sib.swiss/catalog/da5b40b5-fc0b-5366-a522-103459001a83"
      }
    ],

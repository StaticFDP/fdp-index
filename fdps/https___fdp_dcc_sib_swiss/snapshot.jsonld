    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasExclusionCriteria": [
      {
        "@value": "Diagnoses frequently associated with pathogenic genetic variants or chromosomal rearrangements, these include the following ICD-10 diagnose codes: C00-D48, Q00-Q99, D50-D90, patients with rare diseases"
      },
      {
        "@value": "CHUV Genomic Biobank participant's decision to opt out from the GoS-Pilot or incapacity to voluntarily make a decision to participate in the GoS-Pilot"
      },
      {
        "@value": "Significant overrepresentation of specific diagnoses (e.g. patients with type 2 diabetes) or other features (e.g. younger age) to ensure the GoS-Pilot dataset is agnostic of disease groups or research-specific interests"
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasInclusionCriteria": [
      {
        "@value": "Biological samples and preanalytical information available to enable expansion towards multiomic analyses"
      },
      {
        "@value": "Genomic DNA samples from blood allowing to address human constitutional genetic variance"
      },
      {
        "@value": "Broadly representing the diversity of the contemporary Swiss population"
      },
      {
        "@value": "Adult CHUV Genomic Biobank participants who have signed general consent and did not opt-out from GoS-Pilot"
      }
    ],

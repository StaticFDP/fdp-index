        "@value": "Swiss Personalized Health Network (SPHN)"
      }
    ]
  },
  {
    "@id": "http://fdp.dcc.sib.swiss/catalog/64136f6d-1e2b-557d-8c9d-5704e7c4c2e9/metrics/5d27e854a9e78eb3f663331cd47cdc13",

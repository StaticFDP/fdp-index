      {
        "@value": "SwissPedHealth MOMIC Phase 3 Phenotypic Dataset (2024.1)"
      }
    ]
  },
  {
    "@id": "http://fdp.dcc.sib.swiss/dataset/03a029d6-d75d-507c-9074-9c9aae7f43ad/metrics/5d27e854a9e78eb3f663331cd47cdc13",

      },
      {
        "@value": "Newborns, defined as inpatients aged less than 28 days for those born at a gestational age >= 37 weeks, and infants with a corrected age (gestational + postnatal age) < 44 weeks for those born < 37 weeks"
      },
      {
        "@value": "Hospitalized in the neonatal ward at either CHUV, USZ, or KiSpi"
      }

    "http://purl.org/dc/terms/description": [
      {
        "@value": "The dataset comprises the proteomics/transcriptomics data from samples collected during the retrospective phase (Phase 2) of the project. These samples were biobanked by the SwissPedHealth Lighthouse Project, and the Lighthouse team prepared the purified materials. Subsequently, the samples were sent to the Health 2030 Genome Center (H2030GC) for processing."
      }

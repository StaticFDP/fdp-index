        "@value": "Access to the SwissPedDW Demonstrator project data is regulated by the SwissPedDW governance bodies. Approval is given by the SwissPedDW Reuse and Access Committee. Contact: paolo.paioni@kispi.uzh.ch."
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasExclusionCriteria": [
      {
        "@value": "Any coexisting medical or psychological condition that would preclude participation in the required study procedures, as judged by the treating physician"
      },
      {
        "@value": "Umbilical cord blood transplants"
      },
      {
        "@value": "Mismatched related and unrelated donors"
      },
      {
        "@value": "Any condition which precludes initiation of treatment (e.g. breast feeding, pregnancy, infections etc.)"
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasInclusionCriteria": [
      {
        "@value": "AML in CR1"
      },
      {
        "@value": "Routinely measured drug levels (TDM: Therapeutic Drug Monitoring) for Fludarabine"
      },
      {
        "@value": "Inpatient"
      },
      {
        "@value": "Signed informed consent"
      },
      {
        "@value": "HLA-identical and related haplotypical donors"
      }
    ],

        "@id": "_:naa02194b46b8487b9390b15c0420edb2b9"
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasInclusionCriteria": [
      {
        "@value": "Re-use of patient samples and data from existing cohorts (MMA Study: BASEC Nr. PB_2020_00053, SPSS: KEK-Nr. 029/2011, GIS: KEK Nr. 2015-0555, EUCLIDS: UK Research Ethics Committee Nr. 11/LO/1982). Only for samples, for which ethics approval and consent is available (Phase 2)"
      },
      {
        "@value": "Patients attended in pediatric hospitals, All pediatric divisions, Age < 20 years, Male and female, In- and outpatients, acceped and signed MOMIC informed consent (Phase 3)"
      }
    ],

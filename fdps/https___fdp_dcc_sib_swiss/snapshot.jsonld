  {
    "@id": "_:ne8f4c3bad044450e8e9219cbaf009195b1",
    "@type": [
      "http://xmlns.com/foaf/0.1/Agent"
    ],
    "http://xmlns.com/foaf/0.1/name": [
      {
        "@value": "Swiss Personalized Health Network (SPHN)"
      }
    ]
  },
  {
    "@id": "http://fdp.dcc.sib.swiss/dataset/644e122d-6950-5924-a0a2-d5413bc4a7ff#identifier",

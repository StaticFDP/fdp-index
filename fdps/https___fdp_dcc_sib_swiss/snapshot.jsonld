  {
    "@id": "https://biomedit.ch/rdf/sphn-metacat/sphn/health-category/DFMR",
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@value": "data from medical registries and mortality registries"
      }
    ]
  },
  {
    "@id": "http://fdp.dcc.sib.swiss/distribution/5d191008-2758-5ce8-822d-2ce318d9e4c8/metrics/445c0a70d1e214e545b261559e2842f4",

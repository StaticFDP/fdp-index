  {
    "@id": "_:n5afa731371904ca9bb4751e1eb662537b1",
    "@type": [
      "http://xmlns.com/foaf/0.1/Agent"
    ],
    "http://xmlns.com/foaf/0.1/name": [
      {
        "@value": "Swiss Personalized Health Network (SPHN)"
      }
    ]
  },
  {
    "@id": "http://fdp.dcc.sib.swiss/distribution/3f4bd962-c257-56e8-9015-6dcffb458871/metrics/445c0a70d1e214e545b261559e2842f4",

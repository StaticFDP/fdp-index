    "http://purl.org/dc/terms/description": [
      {
        "@value": "This dataset includes a small paediatric clinical reference data pool (PCRDP) with clinical, whole genome sequencing and metabolomics data of healthy children. The data will be used to identify biomarkers which provide information on the activity of drug metabolising enzymes and drug transporters between birth and adolescence."
      }
    ],

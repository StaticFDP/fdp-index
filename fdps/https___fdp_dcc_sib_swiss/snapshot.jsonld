      },
      {
        "@id": "_:n5f8c16a616454b7e85bf2bdb58f9ae2fb5"
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasRatioOfSexes": [
      {
        "@value": "0.94"
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasStudyType": [
      {
        "@value": "Retrospective Observational Study"
      }
    ],

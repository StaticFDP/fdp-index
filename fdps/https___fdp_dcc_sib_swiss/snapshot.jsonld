    "http://purl.org/dc/terms/abstract": [
      {
        "@value": "Infections show a range of diverse phenotypes with variable impact on clinical course and outcomes. Our NDS proposal focuses on this heterogeneity within critically ill patients with severe infections using a combined clinical- and data-driven approach for an improved personalized assessment, characterization and outcome prediction on patients with infections. We will integrate rich and diverse data sources to predict outcomes relevant in the lighthouse project and nested projects"
      }
    ],
    "http://purl.org/dc/terms/accessRights": [

      {
        "@value": "Swiss Personalized Health Network (SPHN)"
      }
    ]
  },
  {
    "@id": "http://fdp.dcc.sib.swiss/distribution/41680801-e0bf-53fd-923d-b7e0d892acbb#identifier",

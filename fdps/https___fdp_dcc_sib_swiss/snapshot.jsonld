    "http://purl.org/dc/terms/description": [
      {
        "@value": "All data from LUCID registry containing routinely collected data from consenting patients and PROMs/PREMs. The main aims of the dataset are to study low-value care (LVC) indicators and their evolution in the impatient population, to assess their downstream consequences, and to evaluate whether the publication of the Swiss Choosing Wisely recommandations in 2016 was associated with a decrease in LVC. We will also study PROMs and PREMs of a limited number of patients, and length of stay predictors usine routinely collected data. Version 2024.1/HUG_CHUV_USZ_USB"
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {

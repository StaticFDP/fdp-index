      {
        "@value": "Clinical Routine"
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasDataUseRestriction": [
      {
        "@value": "The data can be accessed and used by the persons authorized to access the BioMedIT space of the EVIGAITCP project. Other interested parties may contact the project leader (morgan.sangeux@ukbb.ch) to discuss reuse conditions."
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasExclusionCriteria": [
      {
        "@value": "A documented refusal from the patient or the legal representative(s) is the main exclusion criteria. In addition, cases with missing or inaccurate data will be excluded."
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasInclusionCriteria": [
      {
        "@value": "The project will include all data available from UKBB and HUG, with the following inclusion criteria: male or female, children and adults with a neuromuscular disorder, including cerebral palsy and toe walking. It is important to include the maximum time span for both centres in order to maximise our capacity to assemble treatment and control groups from unicentric and multicentric datasets whenever possible. By control group, we mean the group of patients who did not undergo any treatment between two gait data acquisitions."
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasNumberOfPatients": [
      {
        "@value": 3607
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasRatioOfSexes": [
      {
        "@value": "1.46"
      }
    ],
    "https://biomedit.ch/rdf/sphn-metacat/sphn/hasStudyType": [
      {
        "@value": "Retrospective cohort study"
      }
    ],

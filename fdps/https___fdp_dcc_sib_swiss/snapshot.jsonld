    ],
    "http://data.europa.eu/r5r/applicableLegislation": [
      {
        "@value": "Cantonal data protection laws from Vaud and Zurich"
      },
      {
        "@id": "https://www.fedlex.admin.ch/eli/cc/2013/617/de"
      },
      {
        "@id": "https://www.fedlex.admin.ch/eli/cc/2013/642/de"
      },
      {
        "@id": "https://www.fedlex.admin.ch/eli/cc/2022/491/de"
      }
    ],
    "http://purl.org/dc/terms/abstract": [
      {
        "@value": "ADONIS aimes to improve early detection and management of neonatal sepsis, a leading cause of infant mortality and long-term complications in Switzerland and worldwide. Despite its burden, neonatal sepsis remains under-addressed in Swiss research funding. ADONIS leverages a uniquely curated, high-resolution clinical dataset from neonates treated at the University Hospital of Lausanne (CHUV), the University Children's Hospital of Zurich (KiSpi), and University Hospital of Zurich (USZ). The project leverages patient demographics, clinical signs, data from support devices, point-of-care diagnostics, lab results, and treatments to develop advanced machine learning methods. Its objective is to identify subtle physiological changes that precede overt clinical signs of sepsis, thereby enabling earlier and more accurate intervention. ADONIS filles a major gap in national infrastructure by integrating neonatal data into the Swiss Personalized Health Network (SPHN), linking two existing National Data StreamsâSwissPedHealth and IICU. The project's outcomes sets the foundation for data-driven neonatal care and fosters improved sepsis management protocols, potentially reducing mortality, morbidity, and inappropriate antibiotic use among newborns."
      }
    ],

      },
      {
        "@id": "https://www.biomedit.ch/rdf/sphn-schema/sphn/2025/1"
      }
    ],
    "http://purl.org/dc/terms/identifier": [
      {
        "@value": "http://fdp.dcc.sib.swiss/catalog/4c54f9a6-1351-524d-aa62-633a4d4ab9c9"
      }
    ],
    "http://purl.org/dc/terms/isPartOf": [

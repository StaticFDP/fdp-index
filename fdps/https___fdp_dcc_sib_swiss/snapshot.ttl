            dcterms:identifier <https://www.uid.admin.ch/Detail.aspx?uid_id=CHE-115.173.213> ;
            foaf:homepage <https://www.unispital-basel.ch> ] ;
    ns1:hasDataType "Clinical Routine",
        "Longitudinal" ;
    ns1:hasDataUseRestriction "STCS data enriched with hospital CDWH data, will be available to researchers following approval of an application ('nested STCS project') by the STCS Data Center, STCS scientific committee, data governance board, and the competent ethics committee. The data provider agreed to the re-use of the CDWH data by agreeing with the DTUA/DTPA between Hospital (as the data provider), STCS (as the data recipient), and BioMedIT network (as the data processor)." ;

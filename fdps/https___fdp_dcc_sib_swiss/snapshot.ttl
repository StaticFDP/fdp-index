    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/RESTRICTED> ;
    dcterms:conformsTo <http://fdp.dcc.sib.swiss/profile/2f08228e-1789-40f8-84cd-28e3288c3604>,
        <https://www.biomedit.ch/rdf/sphn-schema/sphn/2024/2>,
        <https://www.biomedit.ch/rdf/sphn-schema/sphn/2025/1> ;
    dcterms:description "Containing information to case, patient, procedures, diagnoses, comorbidities, microbiology, lab values, vitals, SOFA, MEWS score. The INFRA dataset conforms to the OMOP CDM v5.4 standard and can be exported through various means, such as OHDSI tools, R packages or as an CSV export. For the existing SPHN Concepts, the dataset can also be exported as a knowledge graph (.TTL) compliant to the SPHN RDF Schema." ;
    dcterms:identifier "http://fdp.dcc.sib.swiss/dataset/00ec6a5c-2c38-5ce7-985c-fe9145d3d1b6" ;
    dcterms:isPartOf <http://fdp.dcc.sib.swiss/catalog/5d5de05f-b96c-5ef7-9ec3-1e53f3d4046c> ;
    dcterms:issued "2026-02-24T14:27:40"^^xsd:dateTime ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0> ;
    dcterms:modified "2026-02-24T14:27:40"^^xsd:dateTime ;
    dcterms:publisher [ a foaf:Agent ;
            foaf:name "Swiss Personalized Health Network (SPHN)" ] ;
    dcterms:source <https://www.biomedit.ch/rdf/sphn-schema/sphn#ClinicalDataPlatform> ;
    dcterms:temporal [ a dcterms:PeriodOfTime ;
            dcat:endDate "2024-12-31"^^xsd:date ;
            dcat:startDate "2020-01-01"^^xsd:date ] ;
    dcterms:title "Infection Radar Data Set" ;
    ns3:SIO_000628 <http://fdp.dcc.sib.swiss/dataset/00ec6a5c-2c38-5ce7-985c-fe9145d3d1b6/metrics/445c0a70d1e214e545b261559e2842f4>,
        <http://fdp.dcc.sib.swiss/dataset/00ec6a5c-2c38-5ce7-985c-fe9145d3d1b6/metrics/5d27e854a9e78eb3f663331cd47cdc13> ;
    dcat:contactPoint <https://biomedit.ch/rdf/sphn-resource/sphn-metacat-d991afd5-4158-42e9-bdf4-d3b76e527594> ;
    dcat:distribution <http://fdp.dcc.sib.swiss/distribution/3b554f0f-af66-589f-b25b-27c966214128> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/HEAL>,
        <http://purl.obolibrary.org/obo/NCIT_C128320> ;
    dcat:version "1.0" ;
    ns1:hasAgeRange "0 - 113" ;
    ns1:hasConsentType "General Consent" ;
    ns1:hasDataProvider [ a foaf:Organization ;
            rdfs:label "Inselspital - Universitatsspital Bern" ;
            dcterms:identifier <https://www.uid.admin.ch/Detail.aspx?uid_id=CHE-229.707.417> ;
            foaf:homepage <https://www.insel.ch> ] ;
    ns1:hasDataType "Clinical Routine" ;
    ns1:hasDataUseRestriction "In accordance with a Data Governance Working Group strategy considering institutional data governance and researchers' interest in compliance with Swiss legal and ethical regulations. Access is given upon approval of the Data Givernance Commission Insel Gruppe, directorate of research at Inselgruppe AG. Contact point: Forschungssupport.DLF@insel.ch" ;
    ns1:hasExclusionCriteria "The exclusion criteria that were applied for excluding patients from the project. These are specific characteristics or attributes of members of the target population which render them unsuitable to contribute data to the project. For the observational study \"Prediction of postoperative infections by strategic data imputation and explainable machine learning\", the data from patients with a documented rejection for the use of healthcare data were excluded." ;
    ns1:hasInclusionCriteria "The inclusion criteria that were applied for including patients as viable data points into the project. These are specific characteristics or attributes that members of the target population must possess such that their data can be considered for the project. While the goal was to build a generalisable semantic layer in our cDWH, we didn't restrict the inclusion, but tried to integrate a broad patient cohort to represent the comprehensive Insel patient cohort. All valid patients records available in the Insel Data Platform with a discharge between 2020-01-01 - 2024-12-31 were included into the project-specific data mart in order to build a project-specific ontology and test the validation rules. For the observational study \"Prediction of postoperative infections by strategic data imputation and explainable machine learning\", a data set of  91,794 patient cases with surgeries recorded in the Bern University Hospital from May 2014 to September 2022 was analysed, Inclusion criteria: Presence of a surgical procedure and at least one laboratory value in the first 30 days after surgery. For the Data Driven Diagnosis Sepsis Cohort, the cases of the patients treated at Insel Group 2020-01-01 - 2024-12-31 were used for the calculation of the SOFA and Phoenix score." ;
    ns1:hasNumberOfPatients 726167 ;
    ns1:hasPublication <https://doi.org/10.21203/rs.3.rs-4594014/v1>,
        <https://dx.doi.org/10.21203/rs.3.rs-6848278/v1> ;
    ns1:hasRatioOfSexes "0.94" ;
    ns1:hasShortTitle "Infection Radar dataset" ;
    ns1:hasStudyType "Observational study" ;
    fdp-o:metadataIdentifier <http://fdp.dcc.sib.swiss/dataset/00ec6a5c-2c38-5ce7-985c-fe9145d3d1b6#identifier> ;

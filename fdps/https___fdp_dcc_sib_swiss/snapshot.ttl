<http://fdp.dcc.sib.swiss/dataset/a9672d84-5496-55d6-a72b-bf7c0343b371> a dcat:Dataset,
        dcat:Resource ;
    rdfs:label "Multi Omics Data (Phase 2)" ;
    ns4:applicableLegislation <https://www.fedlex.admin.ch/eli/cc/2013/617/de>,
        <https://www.fedlex.admin.ch/eli/cc/2013/642/de>,
        <https://www.fedlex.admin.ch/eli/cc/2022/491/de> ;
    ns5:healthCategory <https://biomedit.ch/rdf/sphn-metacat/sphn/health-category/DFIH>,
        <https://biomedit.ch/rdf/sphn-metacat/sphn/health-category/EHRD>,
        <https://biomedit.ch/rdf/sphn-metacat/sphn/health-category/HGEG>,
        <https://biomedit.ch/rdf/sphn-metacat/sphn/health-category/HRAD>,
        <https://biomedit.ch/rdf/sphn-metacat/sphn/health-category/OHMD> ;
    ns5:maxTypicalAge 16 ;
    ns5:minTypicalAge 0 ;
    ns5:numberOfRecords 200 ;
    ns5:numberOfUniqueIndividuals 200 ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/RESTRICTED> ;
    dcterms:conformsTo <http://fdp.dcc.sib.swiss/profile/2f08228e-1789-40f8-84cd-28e3288c3604> ;
    dcterms:description "The dataset comprises both raw and processed data across various omics types, including RNA, DNA, metabolomics, proteomics, and transcriptomics. These samples, originating from the retrospective phase (Phase 2) of the project, were biobanked by the SwissPedHealth Lighthouse Project, with purified materials prepared by the Lighthouse team. The samples were subsequently sent to the Swiss Multi-Omics Center (SMOC) for processing, such as DNA sequencing. The resulting multi-omics data were transferred to BioMedIT, typically in formats such as FASTQ. Both raw and processed data are stored within the BioMedIT infrastructure" ;
    dcterms:identifier "http://fdp.dcc.sib.swiss/dataset/a9672d84-5496-55d6-a72b-bf7c0343b371" ;
    dcterms:isPartOf <http://fdp.dcc.sib.swiss/catalog/727823d9-ab9d-5440-8f0f-78d6d5cecdb0> ;
    dcterms:issued "2026-02-24T14:27:40"^^xsd:dateTime ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0> ;
    dcterms:modified "2026-02-24T14:27:40"^^xsd:dateTime ;
    dcterms:publisher [ a foaf:Agent ;
            foaf:name "Swiss Personalized Health Network (SPHN)" ] ;
    dcterms:source <https://www.biomedit.ch/rdf/sphn-schema/sphn#DataRepository>,
        <https://www.biomedit.ch/rdf/sphn-schema/sphn#OMICSFacility> ;
    dcterms:title "Multi Omics Data (Phase 2)" ;
    ns3:SIO_000628 <http://fdp.dcc.sib.swiss/dataset/a9672d84-5496-55d6-a72b-bf7c0343b371/metrics/445c0a70d1e214e545b261559e2842f4>,
        <http://fdp.dcc.sib.swiss/dataset/a9672d84-5496-55d6-a72b-bf7c0343b371/metrics/5d27e854a9e78eb3f663331cd47cdc13> ;
    dcat:contactPoint <https://biomedit.ch/rdf/sphn-resource/sphn-metacat-b66630aa-4d5a-4748-ab12-e691b208ac53> ;
    dcat:distribution <http://fdp.dcc.sib.swiss/distribution/6d9ddf32-4c46-5de4-8fbf-31c9555f396c>,
        <http://fdp.dcc.sib.swiss/distribution/9844982f-8402-551a-9913-f43b81f0cca7>,
        <http://fdp.dcc.sib.swiss/distribution/c624bc79-72e0-5555-b94e-4eef6c2f9cc0> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/HEAL>,
        <http://purl.obolibrary.org/obo/NCIT_C205365>,
        <http://purl.obolibrary.org/obo/NCIT_C84342> ;
    dcat:version "1.0" ;
    ns1:hasAgeRange "0 - 16 years (for the Immune cohort); N/A (at the moment for the other cohorts)" ;
    ns1:hasConsentType "Consent for reuse of samples must be available." ;
    ns1:hasDataProvider [ a foaf:Organization ;
            rdfs:label "Health 2030 Genome Center" ;
            foaf:homepage <https://www.health2030genome.ch> ],
        [ a foaf:Organization ;
            rdfs:label "Clinical Metabolomics Analysis Center" ;
            foaf:homepage <http://smoc.ethz.ch> ],
        [ a foaf:Organization ;
            rdfs:label "Clinical Proteotype Analysis Center" ;
            foaf:homepage <http://smoc.ethz.ch> ],
        [ a foaf:Organization ;
            rdfs:label "Swiss Multi-Omics Center" ;
            foaf:homepage <http://smoc.ethz.ch> ] ;
    ns1:hasDataType "Omics" ;
    ns1:hasDataUseRestriction "Samples and data of children with extreme phenotypes in Phase 2 arise from existing cohorts where consent to perform omics in stored biospecimens are already available. Conditions for data reuse must be determined with the cohort's responsible PI (not within SwissPedHealth)" ;
    ns1:hasExclusionCriteria "Samples with a documented refusal for further use is excluded" ;
    ns1:hasInclusionCriteria "Phase 2 Cohort (metabolic cohort: elevated homocysteine in plasma)" ;
    ns1:hasNumberOfPatients 200 ;
    ns1:hasRatioOfSexes "89:61 (the number is available for the metabolic cohort)" ;
    ns1:hasShortTitle "Phase 2 Multiomics Dataset" ;
    ns1:hasStudyType "Retrospective study from existing cohort (Phase 2)" ;

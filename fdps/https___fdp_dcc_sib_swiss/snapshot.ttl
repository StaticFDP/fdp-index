        "GTIN" ;
    ns5:hdab [ a foaf:Agent ;
            foaf:homepage "https://www.chuv.ch" ;
            foaf:mbox "eric.giannoni@chuv.ch" ;
            foaf:name "Centre hospitalier universitaire vaudois" ] ;
    ns5:healthCategory <https://biomedit.ch/rdf/sphn-metacat/sphn/health-category/EHRD>,
        <https://biomedit.ch/rdf/sphn-metacat/sphn/health-category/HRAD>,
        <https://biomedit.ch/rdf/sphn-metacat/sphn/health-category/PEHD> ;
    ns5:maxTypicalAge 1 ;
    ns5:minTypicalAge 0 ;
    ns5:numberOfRecords 15361 ;
    ns5:numberOfUniqueIndividuals 15361 ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/RESTRICTED> ;
    dcterms:conformsTo <http://fdp.dcc.sib.swiss/profile/2f08228e-1789-40f8-84cd-28e3288c3604>,
        <https://www.biomedit.ch/rdf/sphn-schema/adonis/2024/1> ;
    dcterms:description "The SPHN ADONIS dataset is a high-resolution, multi-center clinical dataset designed to support research on the early detection of neonatal sepsis using machine learning. It includes data from over 15'000 neonates admitted to the neonatal intensive care units of three major Swiss hospitalsâCHUV, USZ, and KiSpiâbetween 2007 and 2022. The dataset comprises >400 confirmed sepsis cases, >90 necrotizing enterocolitis cases, and a large control group. Data are collected at one-minute intervals and cover more than 800 variables, including vital signs, laboratory results, treatments, and device outputs. All data are semantically harmonized using SPHN standards and mapped to international ontologies such as SNOMED CT, LOINC, and ICD-10. Stored in RDF format and hosted on the secure BioMedIT infrastructure, the dataset is interoperable, pseudonymized, and ethically approved for research use." ;
    dcterms:identifier "http://fdp.dcc.sib.swiss/dataset/15166475-4c6a-52ec-aadb-e8c57049827b" ;
    dcterms:isPartOf <http://fdp.dcc.sib.swiss/catalog/4dd50db2-8d41-5a7f-9011-b5ebfff7da24> ;
    dcterms:issued "2026-02-24T14:27:40"^^xsd:dateTime ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0> ;

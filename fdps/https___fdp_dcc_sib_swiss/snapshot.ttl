            dcat:endDate "2023-12-31"^^xsd:date ;
            dcat:startDate "2017-01-01"^^xsd:date ] ;
    dcterms:title "Nested Project 2: Improving Registration and Data Flows to and From The Swiss Childhood Cancer Registry" ;
    ns5:SIO_000628 <http://fdp.dcc.sib.swiss/dataset/eaffbff3-f44d-51bf-ac39-3af3127de516/metrics/445c0a70d1e214e545b261559e2842f4>,
        <http://fdp.dcc.sib.swiss/dataset/eaffbff3-f44d-51bf-ac39-3af3127de516/metrics/5d27e854a9e78eb3f663331cd47cdc13> ;
    dcat:contactPoint <https://biomedit.ch/rdf/sphn-resource/f1ac1609-23e2-48ca-a1e3-b7b122a6edfc> ;
    dcat:distribution <http://fdp.dcc.sib.swiss/distribution/41680801-e0bf-53fd-923d-b7e0d892acbb>,
        <http://fdp.dcc.sib.swiss/distribution/76426017-9c45-5962-8045-9e3d7dac91d7> ;
    dcat:keyword "SwissPedCancer-2025.1-SwissPedCancer",
        "SwissPedHealth-2025.1-SwissPedCancer" ;
    dcat:theme <http://purl.obolibrary.org/obo/NCIT_C15783>,
        <https://publications.europa.eu/resource/authority/data-theme/HEAL> ;
    dcat:version "1.0" ;
    foaf:page <https://schemascope.dcc.sib.swiss/?project=SwissPedCancer&version=2025.1&dataset=SwissPedCancer> ;
    ns1:hasConsentType "Opt Out" ;
    ns1:hasDataProvider [ a foaf:Organization ;
            rdfs:label "Universitats-Kinderspital Zurich" ;
            dcterms:identifier <https://www.uid.admin.ch/Detail.aspx?uid_id=CHE-105.834.378> ;
            foaf:homepage <https://www.kispi.uzh.ch> ],
        [ a foaf:Organization ;
            rdfs:label "NDS SPH Registry" ],
        [ a foaf:Organization ;
            rdfs:label "Inselspital - Universitatsspital Bern" ;
            dcterms:identifier <https://www.uid.admin.ch/Detail.aspx?uid_id=CHE-229.707.417> ;
            foaf:homepage <https://www.insel.ch> ],
        [ a foaf:Organization ;
            rdfs:label "Centre hospitalier universitaire vaudois" ;
            dcterms:identifier <https://www.uid.admin.ch/Detail.aspx?uid_id=CHE-108.910.225> ;
            foaf:homepage <https://www.chuv.ch> ],
        [ a foaf:Organization ;
            rdfs:label "Hopitaux universitaires de Geneve" ;
            dcterms:identifier <https://www.uid.admin.ch/Detail.aspx?uid_id=CHE-108.907.884> ;
            foaf:homepage <https://www.hug.ch> ],
        [ a foaf:Organization ;
            rdfs:label "Luzerner Kantonsspital" ;
            dcterms:identifier <https://www.uid.admin.ch/Detail.aspx?uid_id=CHE-109.329.783> ;
            foaf:homepage <https://www.luks.ch> ],
        [ a foaf:Organization ;
            rdfs:label "Universitats-Kinderspital beider Basel" ;
            dcterms:identifier <https://www.uid.admin.ch/Detail.aspx?uid_id=CHE-112.453.018> ;
            foaf:homepage <https://www.ukbb.ch> ] ;
    ns1:hasDataType "Clinical Routine" ;
    ns1:hasDataUseRestriction "Access to the NDS data is regulated through the SwissPedHealth infrastructure consortium agreement V2.0 18.11.2022. As brief explanation: When planning to carry out a project using data from the SwissPedHealth NDS, you will need to set up a data project consortium agreement (DPCA) involving all participating partners. Note that this should include 'internal' SwissPedHealth partners and 'external' partners, i.e. those not part of the SwissPedHealth NDS Infrastructure Consortium. For the DPCA, projects should consider the SwissPedHealth general terms and conditions (GTCs) and, wherever possible, try to adopt them without or with minor deviations. This will facilitate the process of legal review and signing for all 'internal' partners, since the GTCs will have already been reviewed as part of the development and adoption process. If deviations are required, these will need to be specified in the DPCA, and should be highlighted during the legal review of the DPCA. Note that the following additional documentation will be required to complete the DPCA: Project funding application/Proof of funding, Study protocol and Ethical approval. In case the latter is not available it should be added as soon as available, and the DPCA cannot be executed without evidence of ethical review and approval. All parts highlighted in yellow in the DPCA template need to be completed/amended. All DPCAs will need to incorporate a data transfer and use agreement (DTUA) and data transfer and processing agreement (DTPA). These are included in the SwissPedHealth DPCA template, reflecting SPHN requirements. Please note that adaptations may be necessary in cases where the Data Processors are not one of the BioMedIT nodes (SENSA - Lausanne, SciCORE - Basel, SIS - Zurich). For the DTUA section, each project will need to describe and depict the planned data flow as well as data and metadata to be transferred. All parts highlighted in yellow in the DTUA and DTPA templates need to be completed/amended." ;
    ns1:hasExclusionCriteria "Resident abroad at diagnosis",
        "Veto against cancer registration" ;
    ns1:hasInclusionCriteria "Age < 20 years at diagnosis",
        "Diagnosis codes (ICD-10) indicating malignant cancers and benign central nervous systems tumours, excluding nonmelanoma skin cancers to align with the ChCR inclusion criteria (https://www.childhoodcancerregistry.ch/reporting-obligation/what-needs-to-be-reported/, Table 2)",
        "In- and outpatients",
        "Male and female",
        "not resident abroad at diagnosis" ;
    ns1:hasRatioOfSexes "1.16" ;
    ns1:hasStudyType "Quality Assurance" ;

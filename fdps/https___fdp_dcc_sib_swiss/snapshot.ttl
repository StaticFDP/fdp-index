    ns5:numberOfUniqueIndividuals 98 ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/RESTRICTED> ;
    dcterms:conformsTo <http://fdp.dcc.sib.swiss/profile/2f08228e-1789-40f8-84cd-28e3288c3604>,
        <https://www.biomedit.ch/rdf/sphn-schema/sph/2024/1> ;
    dcterms:description "The dataset consists of phenotypes extracted from free-text clinical reports collected over 30 years, where individuals were referred to with suspicion of a remethylation disorder (RD). All individuals presented with elevated plasma homocysteine levels. Phenotype annotations were extracted using a semi-automated pipeline and reviewed by at least two annotators in consultation with medical experts. The dataset is structured in RDF format and serves as a benchmark for the newly developed SPH Concept 'Phenotypic Observation'" ;
    dcterms:identifier "http://fdp.dcc.sib.swiss/dataset/4eeee87e-64df-5262-9b4d-3d22651ba6ad" ;
    dcterms:isPartOf <http://fdp.dcc.sib.swiss/catalog/727823d9-ab9d-5440-8f0f-78d6d5cecdb0> ;

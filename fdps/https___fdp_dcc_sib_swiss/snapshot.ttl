<http://fdp.dcc.sib.swiss/catalog/08d6b731-ddcc-520a-b869-83fedc93d4e6> a dcat:Catalog,
        dcat:Resource ;
    rdfs:label "SwissPedHealth Nested project 4: Surveillance of Antimicrobial Use in Swiss Paediatric Inpatient Care (SwissPedAntibio)" ;
    ns5:applicableLegislation <https://www.fedlex.admin.ch/eli/cc/2013/617/de>,
        <https://www.fedlex.admin.ch/eli/cc/2013/642/de>,
        <https://www.fedlex.admin.ch/eli/cc/2022/491/de>,
        "Cantonal data protection laws" ;
    ns3:maxTypicalAge 20 ;
    ns3:minTypicalAge 0 ;
    ns3:numberOfUniqueIndividuals 180383 ;
    dcterms:abstract "SwissPedAntibio aims to establish and carry out on-going surveillance of antibiotic use in the paediatric inpatient population in Switzerland, using the infrastructure of the National Data Stream SwissPedHealth.The primary aims of antibiotic use surveillance are to assess performance indicators and identify targets for quality improvement of antimicrobial prescribing, to design targeted interventions in participating hospitals and to assess their effectiveness, and to support benchmarking." ;

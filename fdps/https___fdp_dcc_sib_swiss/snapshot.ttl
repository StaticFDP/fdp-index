        <http://fdp.dcc.sib.swiss/dataset/334589be-975f-5e16-b930-0534f463a1d2/metrics/5d27e854a9e78eb3f663331cd47cdc13> ;
    dcat:contactPoint <https://biomedit.ch/rdf/sphn-resource/a9451e23-69c4-40f3-b2ad-07ff33d11a07> ;
    dcat:distribution <http://fdp.dcc.sib.swiss/distribution/2b9b5cb3-8980-594d-88de-a3d89a7d17b1> ;
    dcat:theme <http://purl.obolibrary.org/obo/NCIT_C205365>,
        <http://purl.obolibrary.org/obo/NCIT_C84342> ;
    dcat:version "1.0" ;
    ns1:hasAgeRange "0 - 16 (Immune cohort)" ;
    ns1:hasConsentType "General Consent" ;
    ns1:hasDataProvider [ a foaf:Organization ;
            rdfs:label "Health 2030 Genome Center" ;
            foaf:homepage <https://www.health2030genome.ch> ] ;
    ns1:hasDataType "Metadata" ;
    ns1:hasDataUseRestriction "Samples and data of children with extreme phenotypes in Phase 2 arise from existing cohorts where consent to perform omics in stored biospecimens are already available. Conditions for data reuse must be determined with the cohort's responsible PI (not within SwissPedHealth)" ;
    ns1:hasExclusionCriteria "Samples with a documented refusal for further use is excluded" ;
    ns1:hasInclusionCriteria "Phase 2 Cohort (metabolic cohort: elevated homocysteine in plasma)" ;
    ns1:hasNumberOfPatients 200 ;
    ns1:hasRatioOfSexes "1.46 (metabolic cohort)" ;

<http://fdp.dcc.sib.swiss/dataset/be1edcab-4e5e-59b7-8a34-f3bb0f551343> a dcat:Dataset,
        dcat:Resource ;
    rdfs:label "Cohort Demonstrator USB dataset (2012-2024)" ;
    ns4:applicableLegislation <https://www.fedlex.admin.ch/eli/cc/2007/279/de>,
        <https://www.fedlex.admin.ch/eli/cc/2013/617/de>,
        <https://www.fedlex.admin.ch/eli/cc/2013/642/de>,
        <https://www.fedlex.admin.ch/eli/cc/2022/491/de>,
        "Cantonal data protection laws" ;
    ns5:hasCodingSystem <https://loinc.org> ;
    ns5:hdab [ a foaf:Agent ;
            foaf:mbox "sc.stcs@usz.ch" ;
            foaf:name "STCS Scientific Committee and Data Governance Board" ] ;
    ns5:healthCategory <https://biomedit.ch/rdf/sphn-metacat/sphn/health-category/EHRD> ;
    ns5:maxTypicalAge 93 ;
    ns5:minTypicalAge 19 ;
    ns5:numberOfRecords 1276 ;
    ns5:numberOfUniqueIndividuals 1276 ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/RESTRICTED> ;
    dcterms:conformsTo <http://fdp.dcc.sib.swiss/profile/2f08228e-1789-40f8-84cd-28e3288c3604>,
        <https://www.biomedit.ch/rdf/sphn-schema/sphn/2024/2> ;
    dcterms:description "The dataset was derived from a data extraction of the USB CDWH for STCS patients followed at the USB. Corresponding patient records were identified using the linking log (STCS person IDs linked with Hospital person ID) of IDEAL provided to the CDWH. The extraction process was guided by an RDF schema covering 23 SPHN re-used concepts, such as 'Lab test', which included 17 different lab tests identified via LOINC codes. Transformation into RDF using the SPHN connector and transferred to CHIL after encryption with sett. Authorized researchers can browse and query this dataset on CHIL. From this dataset, approximately 500,000 records were processed and imported into the STCS research database, significantly enhancing the granularity of data available for research purposes." ;
    dcterms:identifier "http://fdp.dcc.sib.swiss/dataset/be1edcab-4e5e-59b7-8a34-f3bb0f551343" ;
    dcterms:isPartOf <http://fdp.dcc.sib.swiss/catalog/b11dbf20-e08e-5bf1-a1e5-ba64457e17c0> ;
    dcterms:issued "2026-02-24T14:27:40"^^xsd:dateTime ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0> ;
    dcterms:modified "2026-02-24T14:27:40"^^xsd:dateTime ;
    dcterms:publisher [ a foaf:Agent ;
            foaf:name "Swiss Personalized Health Network (SPHN)" ] ;
    dcterms:source <https://www.biomedit.ch/rdf/sphn-schema/sphn#ClinicalDataPlatform> ;
    dcterms:temporal [ a dcterms:PeriodOfTime ;
            dcat:endDate "2024-12-30"^^xsd:date ;
            dcat:startDate "2012-01-01"^^xsd:date ] ;
    dcterms:title "Cohort Demonstrator USB dataset (2012-2024)" ;
    ns3:SIO_000628 <http://fdp.dcc.sib.swiss/dataset/be1edcab-4e5e-59b7-8a34-f3bb0f551343/metrics/445c0a70d1e214e545b261559e2842f4>,
        <http://fdp.dcc.sib.swiss/dataset/be1edcab-4e5e-59b7-8a34-f3bb0f551343/metrics/5d27e854a9e78eb3f663331cd47cdc13> ;
    dcat:contactPoint <https://biomedit.ch/rdf/sphn-resource/sphn-metacat-cb0e220e-daa7-42c6-83cd-7b42978c8304> ;
    dcat:distribution <http://fdp.dcc.sib.swiss/distribution/8799a727-184a-51cd-93cd-221d9547ef92>,
        <http://fdp.dcc.sib.swiss/distribution/aa38f756-7f57-5575-b144-ec4b040c95bb> ;
    dcat:theme <http://edamontology.org/3366>,
        <http://publications.europa.eu/resource/authority/data-theme/HEAL>,
        <http://purl.obolibrary.org/obo/NCIT_C202448>,
        <http://purl.obolibrary.org/obo/T4FS_0000487>,
        <http://www.ebi.ac.uk/efo/EFO_0030083> ;
    dcat:version "1.0" ;
    ns1:hasAgeRange "19 - 93" ;
    ns1:hasConsentType "Informed Consent" ;
    ns1:hasDataProvider [ a foaf:Organization ;
            rdfs:label "Universitatsspital Basel" ;
            dcterms:identifier <https://www.uid.admin.ch/Detail.aspx?uid_id=CHE-115.173.213> ;
            foaf:homepage <https://www.unispital-basel.ch> ] ;
    ns1:hasDataType "Clinical Routine",
        "Longitudinal" ;
    ns1:hasDataUseRestriction "STCS data enriched with hospital CDWH data, will be available to researchers following approval of an application ('nested STCS project') by the STCS Data Center, STCS scientific committee, data governance board, and the competent ethics committee. The data provider agreed to the re-use of the CDWH data by agreeing with the DTUA/DTPA between Hospital (as the data provider), STCS (as the data recipient), and BioMedIT network (as the data processor)." ;
    ns1:hasInclusionCriteria "STCS patients (solid organ transplants recipients) at USB" ;

<http://fdp.dcc.sib.swiss/dataset/334589be-975f-5e16-b930-0534f463a1d2> a dcat:Dataset,
        dcat:Resource ;
    rdfs:label "Phase 2 - Sequencing Metadata" ;
    ns3:applicableLegislation <https://www.fedlex.admin.ch/eli/cc/2013/617/de>,
        <https://www.fedlex.admin.ch/eli/cc/2013/642/de>,
        <https://www.fedlex.admin.ch/eli/cc/2022/491/de>,
        "Cantonal data protection laws" ;
    ns4:hdab [ a foaf:Agent ;
            foaf:mbox "luregn.schlapbach@kispi.uzh.ch" ;
            foaf:name "SPH Consortium" ] ;
    ns4:healthCategory <https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/HGPD>,
        <https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/HPML> ;
    ns4:maxTypicalAge 16 ;
    ns4:minTypicalAge 0 ;
    ns4:numberOfUniqueIndividuals 200 ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC> ;
    dcterms:alternative "MOMIC-Phase2-SeqMetadata" ;
    dcterms:conformsTo <http://fdp.dcc.sib.swiss/profile/2f08228e-1789-40f8-84cd-28e3288c3604> ;
    dcterms:description "The dataset comprises the quality check (QC) metadata of the whole genome sequencing (WGS) and bulk RNA sequencing (RNA-seq) from samples collected during the retrospective phase (Phase 2) of the project. These samples were biobanked by the SwissPedHealth Lighthouse Project, and the Lighthouse team prepared the purified materials. Subsequently, the samples were sent to the Health 2030 Genome Center (H2030GC) for processing." ;
    dcterms:identifier "http://fdp.dcc.sib.swiss/dataset/334589be-975f-5e16-b930-0534f463a1d2" ;

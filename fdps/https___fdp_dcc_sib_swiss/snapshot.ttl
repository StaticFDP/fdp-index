        <http://purl.obolibrary.org/obo/NCIT_C154626>,
        <http://purl.obolibrary.org/obo/NCIT_C189005>,
        <http://purl.obolibrary.org/obo/NCIT_C75445> ;
    dcat:version "1.0" ;
    ns1:hasAgeRange "0.6 - 80" ;
    ns1:hasConsentType "General Consent" ;
    ns1:hasDataProvider [ a foaf:Organization ;
            rdfs:label "Universitats-Kinderspital beider Basel" ;
            dcterms:identifier <https://www.uid.admin.ch/Detail.aspx?uid_id=CHE-112.453.018> ;
            foaf:homepage <https://www.ukbb.ch> ],
        [ a foaf:Organization ;
            rdfs:label "Hopitaux universitaires de Geneve" ;
            dcterms:identifier <https://www.uid.admin.ch/Detail.aspx?uid_id=CHE-108.907.884> ;
            foaf:homepage <https://www.hug.ch> ] ;
    ns1:hasDataType "Clinical Routine",
        "Gait Analysis" ;
    ns1:hasDataUseRestriction "The data can be accessed and used by the persons authorized to access the BioMedIT space of the EVIGAITCP project. Other interested parties may contact the project leader (morgan.sangeux@ukbb.ch) to discuss reuse conditions." ;
    ns1:hasExclusionCriteria "A documented refusal from the patient or the legal representative(s) is the main exclusion criteria. In addition, cases with missing or inaccurate data will be excluded." ;
    ns1:hasInclusionCriteria "The project will include all data available from UKBB and HUG, with the following inclusion criteria: male or female, children and adults with a neuromuscular disorder, including cerebral palsy and toe walking. It is important to include the maximum time span for both centres in order to maximise our capacity to assemble treatment and control groups from unicentric and multicentric datasets whenever possible. By control group, we mean the group of patients who did not undergo any treatment between two gait data acquisitions." ;
    ns1:hasNumberOfPatients 3607 ;
    ns1:hasRatioOfSexes "1.46" ;
    ns1:hasStudyType "Retrospective cohort study" ;

    ns2:maxTypicalAge 80 ;
    ns2:minTypicalAge 6 ;
    ns2:numberOfRecords 3607 ;
    ns2:numberOfUniqueIndividuals 3607 ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/RESTRICTED> ;
    dcterms:conformsTo <http://fdp.dcc.sib.swiss/profile/2f08228e-1789-40f8-84cd-28e3288c3604> ;
    dcterms:description "The dataset contains clinical gait analysis data for two populations, cerebral palsy and toe walking patients, that were collected at two different centers, the clinical gait analysis services at UKBB and HUG. The dataset contains physical examination data (anthropometric measurements, range of motion measurements, muscle strength assessments and spasticity assessments), surgical procedure data, and instrumented gait analysis data (spatio-temporal parameters, gait scores, kinematics, kinetics and electromyography data), as well as SOP for both centers." ;
    dcterms:identifier "http://fdp.dcc.sib.swiss/dataset/c72aa453-d1bf-5b11-a133-3cee3e833de1" ;
    dcterms:isPartOf <http://fdp.dcc.sib.swiss/catalog/b865fa92-78f0-59a6-bd27-e03ba9b2517d> ;

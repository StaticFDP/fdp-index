    ns4:hdab [ a foaf:Agent ;
            foaf:mbox "sc.stcs@usz.ch" ;
            foaf:name "STCS Scientific Committee and Data Governance Board" ] ;
    ns4:healthCategory <https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/EHRS> ;
    ns4:maxTypicalAge 93 ;
    ns4:minTypicalAge 19 ;
    ns4:numberOfUniqueIndividuals 1276 ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/RESTRICTED> ;
    dcterms:conformsTo <http://fdp.dcc.sib.swiss/profile/2f08228e-1789-40f8-84cd-28e3288c3604>,
        <https://www.biomedit.ch/rdf/sphn-schema/sphn/2024/2> ;
    dcterms:description "The dataset was derived from a data extraction of the USB CDWH for STCS patients followed at the USB. Corresponding patient records were identified using the linking log (STCS person IDs linked with Hospital person ID) of IDEAL provided to the CDWH. The extraction process was guided by an RDF schema covering 23 SPHN re-used concepts, such as 'Lab test', which included 17 different lab tests identified via LOINC codes. Transformation into RDF using the SPHN connector and transferred to CHIL after encryption with sett. Authorized researchers can browse and query this dataset on CHIL. From this dataset, approximately 500,000 records were processed and imported into the STCS research database, significantly enhancing the granularity of data available for research purposes." ;
    dcterms:identifier "http://fdp.dcc.sib.swiss/dataset/be1edcab-4e5e-59b7-8a34-f3bb0f551343" ;
    dcterms:isPartOf <http://fdp.dcc.sib.swiss/catalog/b11dbf20-e08e-5bf1-a1e5-ba64457e17c0> ;
    dcterms:issued "2026-09-23T21:12:32"^^xsd:dateTime ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:modified "2026-09-23T21:12:32"^^xsd:dateTime ;
    dcterms:publisher [ a foaf:Agent ;
            foaf:name "Swiss Personalized Health Network (SPHN)" ] ;
    dcterms:source <https://www.biomedit.ch/rdf/sphn-schema/sphn/individual#ClinicalDataPlatform> ;
    dcterms:temporal [ a dcterms:PeriodOfTime ;
            dcat:endDate "2024-12-30"^^xsd:date ;
            dcat:startDate "2012-01-01"^^xsd:date ] ;

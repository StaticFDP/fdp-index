    ns5:SIO_000628 <http://fdp.dcc.sib.swiss/catalog/4dd50db2-8d41-5a7f-9011-b5ebfff7da24/metrics/445c0a70d1e214e545b261559e2842f4>,
        <http://fdp.dcc.sib.swiss/catalog/4dd50db2-8d41-5a7f-9011-b5ebfff7da24/metrics/5d27e854a9e78eb3f663331cd47cdc13> ;
    dcat:contactPoint <https://biomedit.ch/rdf/sphn-resource/d423cc8a-8853-490f-9c7a-94bca2ef6eb6> ;
    dcat:dataset <http://fdp.dcc.sib.swiss/dataset/15166475-4c6a-52ec-aadb-e8c57049827b> ;

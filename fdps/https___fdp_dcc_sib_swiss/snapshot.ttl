<http://fdp.dcc.sib.swiss/dataset/2f03de29-b60e-536b-9362-389e40fa0585> a dcat:Dataset,
        dcat:Resource ;
    rdfs:label "Genome of Switzerland Pilot: Genomic Sequences" ;
    ns3:applicableLegislation <https://www.fedlex.admin.ch/eli/cc/2013/617/de>,
        <https://www.fedlex.admin.ch/eli/cc/2013/642/de>,
        <https://www.fedlex.admin.ch/eli/cc/2022/491/de> ;
    ns4:hdab [ a foaf:Agent ;
            foaf:mbox "elodie.ristorcelli@chuv.ch" ;
            foaf:name "Elodie Ristorcelli" ] ;
    ns4:healthCategory <https://hdeu-dcat.acceptance.data.health.europa.eu/resource/authority/healthcategories/HGPD> ;
    ns4:minTypicalAge 18 ;
    ns4:numberOfRecords 123 ;
    ns4:numberOfUniqueIndividuals 1000 ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/RESTRICTED> ;
    dcterms:alternative "GoS-Pilot - FASTQ" ;
    dcterms:conformsTo <http://fdp.dcc.sib.swiss/profile/2f08228e-1789-40f8-84cd-28e3288c3604> ;
    dcterms:description "This FASTQ dataset contains raw sequencing reads from participants included in the Genome of Switzerland Pilot. It represents the primary sequence-level output generated before alignment and variant calling, and supports downstream genome analysis including quality control, read alignment, variant discovery, allele-frequency estimation, population-structure analysis, and pharmacogenomic research. The dataset is intended to enable research on genomic variation within the contemporary Swiss population starting from the raw sequencing data." ;
    dcterms:identifier "http://fdp.dcc.sib.swiss/dataset/2f03de29-b60e-536b-9362-389e40fa0585" ;
    dcterms:isPartOf <http://fdp.dcc.sib.swiss/catalog/087d497a-6f23-564d-a77a-a989a4df5d67> ;
    dcterms:issued "2026-09-23T21:15:05"^^xsd:dateTime ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:modified "2026-09-23T21:15:05"^^xsd:dateTime ;
    dcterms:publisher [ a foaf:Agent ;
            foaf:name "Swiss Personalized Health Network (SPHN)" ] ;
    dcterms:source <https://www.biomedit.ch/rdf/sphn-schema/sphn/individual#Biobank> ;
    dcterms:temporal [ a dcterms:PeriodOfTime ;
            dcat:endDate "2024-02-08"^^xsd:date ;
            dcat:startDate "2013-01-25"^^xsd:date ] ;
    dcterms:title "Genome of Switzerland Pilot: Genomic Sequences" ;
    ns5:SIO_000628 <http://fdp.dcc.sib.swiss/dataset/2f03de29-b60e-536b-9362-389e40fa0585/metrics/445c0a70d1e214e545b261559e2842f4>,
        <http://fdp.dcc.sib.swiss/dataset/2f03de29-b60e-536b-9362-389e40fa0585/metrics/5d27e854a9e78eb3f663331cd47cdc13> ;
    dcat:contactPoint <https://biomedit.ch/rdf/sphn-resource/3ba7e516-12b9-44f1-b64b-4f4d928d326e>,
        <https://biomedit.ch/rdf/sphn-resource/8e562c8a-0500-4fa4-9959-d576bef5dfc1>,
        <https://biomedit.ch/rdf/sphn-resource/f4e83746-046e-441c-b839-0c358fd40a4c> ;
    dcat:distribution <http://fdp.dcc.sib.swiss/distribution/7a084478-9f83-56ab-bdeb-100f2a8363ff> ;
    dcat:theme <http://www.ebi.ac.uk/efo/EFO_0004600>,
        <http://www.ebi.ac.uk/efo/EFO_0008479>,
        <https://publications.europa.eu/resource/authority/data-theme/HEAL> ;
    dcat:version "1.0" ;
    ns1:hasBiobank [ a foaf:Organization ;
            rdfs:label "CHUV Genomic Biobank" ;
            foaf:homepage <https://www.chuv.ch/fr/consentement-general/cg-home/comprendre/la-biobanque-genomique-du-chuv-bgc> ] ;
    ns1:hasConsentType "General Consent" ;
    ns1:hasDataProvider [ a foaf:Organization ;
            rdfs:label "CHUV Genomic Biobank" ;
            foaf:homepage <https://www.chuv.ch/fr/consentement-general/cg-home/comprendre/la-biobanque-genomique-du-chuv-bgc> ] ;
    ns1:hasDataType "Genomics" ;
    ns1:hasDataUseRestriction "Third parties can apply for reuse. Access is granted upon approval of the project board according to the reuse conditions described in the protocol and respective agreements." ;
    ns1:hasExclusionCriteria "CHUV Genomic Biobank participant's decision to opt out from the GoS-Pilot or incapacity to voluntarily make a decision to participate in the GoS-Pilot",
        "Diagnoses frequently associated with pathogenic genetic variants or chromosomal rearrangements, these include the following ICD-10 diagnose codes: C00-D48, Q00-Q99, D50-D90, patients with rare diseases",
        "Significant overrepresentation of specific diagnoses (e.g. patients with type 2 diabetes) or other features (e.g. younger age) to ensure the GoS-Pilot dataset is agnostic of disease groups or research-specific interests" ;
    ns1:hasInclusionCriteria "Adult CHUV Genomic Biobank participants who have signed general consent and did not opt-out from GoS-Pilot",
        "Biological samples and preanalytical information available to enable expansion towards multiomic analyses",
        "Broadly representing the diversity of the contemporary Swiss population",
        "Genomic DNA samples from blood allowing to address human constitutional genetic variance" ;
    ns1:hasRatioOfSexes "0.495" ;
    ns1:hasStudyType "Infrastructure Project (Population Genomic Reference Panel)" ;

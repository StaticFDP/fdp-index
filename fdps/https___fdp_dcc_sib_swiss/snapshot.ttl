        <https://doi.org/10.1038/s41390-025-04159-x>,
        <https://doi.org/10.3389/fped.2025.1563979> ;
    dcterms:issued "2026-09-23T21:12:16"^^xsd:dateTime ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:modified "2026-09-23T21:12:16"^^xsd:dateTime ;

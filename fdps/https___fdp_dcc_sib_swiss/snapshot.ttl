<http://fdp.dcc.sib.swiss/dataset/15166475-4c6a-52ec-aadb-e8c57049827b> a dcat:Dataset,
        dcat:Resource ;
    rdfs:label "ADONIS Cohort: High-Resolution Clinical Data for Neonatal Sepsis Detection" ;
    ns4:applicableLegislation <https://www.fedlex.admin.ch/eli/cc/2013/617/de>,
        <https://www.fedlex.admin.ch/eli/cc/2013/642/de>,
        <https://www.fedlex.admin.ch/eli/cc/2022/491/de>,

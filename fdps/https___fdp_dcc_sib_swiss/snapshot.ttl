    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/RESTRICTED> ;
    dcterms:conformsTo <http://fdp.dcc.sib.swiss/profile/2f08228e-1789-40f8-84cd-28e3288c3604>,
        <https://www.biomedit.ch/rdf/sphn-schema/sphn/2024/2> ;
    dcterms:description "The dataset contains drug plasma level data of busulfan and complementary clinical data of patients receiving busulfan-based conditioning regimens for stem cell transplantation. The data will be used in pharmacokinetic models to better understand the pharmacokinetics of this drug and therefore be able to optimise the dosage regimens for children." ;

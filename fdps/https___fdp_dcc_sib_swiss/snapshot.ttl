    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/RESTRICTED> ;
    dcterms:alternative "SwissPedLung" ;
    dcterms:conformsTo <http://fdp.dcc.sib.swiss/profile/2f08228e-1789-40f8-84cd-28e3288c3604>,
        <https://www.biomedit.ch/rdf/sphn-schema/sph/2025/1>,
        <https://www.biomedit.ch/rdf/sphn-schema/sphn/2025/1> ;
    dcterms:description "Lung function tests (LFT) are key diagnostic and outcome measures for lung diseases (e.g. asthma, ex-preterm, cystic fibrosis), but test result retrieval, quality control, and documentation are manual. Research projects that use routine data from EHRs are hampered by excessive manual work. This NP will 1) identify priority LFT elements, 2) develop appropriate approaches for collecting, harmonizing and integrating these elements into the SPHN clinical data warehouse (CDW) infrastructure and 3) transfer standardized LFT results from clinical data warehouses (CDW) to BioMedIT." ;
    dcterms:identifier "http://fdp.dcc.sib.swiss/dataset/1d5cc949-d1c3-5f41-a353-9b637870d7d5" ;

<http://fdp.dcc.sib.swiss/catalog/86fb83e6-27ae-55f4-9b57-6fdeb97b719b> a dcat:Catalog,
        dcat:Resource ;
    rdfs:label "Pediatric Personalized Research Network Switzerland - a Joint Pediatric National Data Stream (SwissPedHealth)" ;
    ns3:applicableLegislation <https://www.fedlex.admin.ch/eli/cc/2013/617/de>,
        <https://www.fedlex.admin.ch/eli/cc/2013/642/de>,
        <https://www.fedlex.admin.ch/eli/cc/2022/491/de>,

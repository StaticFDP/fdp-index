    dcterms:temporal [ a dcterms:PeriodOfTime ;
            dcat:endDate "2024-12-30"^^xsd:date ;
            dcat:startDate "2012-01-01"^^xsd:date ] ;
    dcterms:title "Cohort Demonstrator USB Dataset (2012-2024)" ;
    ns2:SIO_000628 <http://fdp.dcc.sib.swiss/dataset/be1edcab-4e5e-59b7-8a34-f3bb0f551343/metrics/445c0a70d1e214e545b261559e2842f4>,
        <http://fdp.dcc.sib.swiss/dataset/be1edcab-4e5e-59b7-8a34-f3bb0f551343/metrics/5d27e854a9e78eb3f663331cd47cdc13> ;

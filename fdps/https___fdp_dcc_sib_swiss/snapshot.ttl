    ns4:minTypicalAge 18 ;
    ns4:numberOfRecords 123 ;
    ns4:numberOfUniqueIndividuals 1000 ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/RESTRICTED> ;
    dcterms:alternative "GoS-Pilot - VCF" ;
    dcterms:conformsTo <http://fdp.dcc.sib.swiss/profile/2f08228e-1789-40f8-84cd-28e3288c3604> ;
    dcterms:description "This VCF dataset contains genomic variant calls derived from participants included in the Genome of Switzerland Pilot. It provides the processed variant-level representation of the sequenced genomes and supports downstream analyses of genetic diversity, allele frequencies, population structure, pharmacogenomic variation, and other clinically or biologically relevant genomic findings. The dataset is intended to enable research on genomic variation within the contemporary Swiss population while avoiding the need to work directly from raw sequencing reads." ;
    dcterms:identifier "http://fdp.dcc.sib.swiss/dataset/8de36f97-d98a-531e-a2a5-421df8646742" ;
    dcterms:isPartOf <http://fdp.dcc.sib.swiss/catalog/087d497a-6f23-564d-a77a-a989a4df5d67> ;

<http://fdp.dcc.sib.swiss/dataset/c72aa453-d1bf-5b11-a133-3cee3e833de1> a dcat:Dataset,
        dcat:Resource ;
    rdfs:label "Clinical gait analysis data for cerebral palsy and toe walking patients" ;
    ns4:applicableLegislation <https://www.fedlex.admin.ch/eli/cc/2013/617/de>,
        <https://www.fedlex.admin.ch/eli/cc/2013/642/de>,
        <https://www.fedlex.admin.ch/eli/cc/2022/491/de>,
        "Cantonal data protection laws" ;
    ns5:hdab [ a foaf:Agent ;
            foaf:mbox "EVIGAITCP project partners, UKBB as responsible organization. Contact point: mor-gan.Sangeux@ukbb.c" ;
            foaf:name "" ] ;
    ns5:healthCategory <https://biomedit.ch/rdf/sphn-metacat/sphn/health-category/DFRM>,
        <https://biomedit.ch/rdf/sphn-metacat/sphn/health-category/EHRD> ;
    ns5:maxTypicalAge 80 ;
    ns5:minTypicalAge 6 ;
    ns5:numberOfRecords 3607 ;
    ns5:numberOfUniqueIndividuals 3607 ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/RESTRICTED> ;
    dcterms:conformsTo <http://fdp.dcc.sib.swiss/profile/2f08228e-1789-40f8-84cd-28e3288c3604> ;
    dcterms:description "The dataset contains clinical gait analysis data for two populations, cerebral palsy and toe walking patients, that were collected at two different centers, the clinical gait analysis services at UKBB and HUG. The dataset contains physical examination data (anthropometric measurements, range of motion measurements, muscle strength assessments and spasticity assessments), surgical procedure data, and instrumented gait analysis data (spatio-temporal parameters, gait scores, kinematics, kinetics and electromyography data), as well as SOP for both centers." ;
    dcterms:identifier "http://fdp.dcc.sib.swiss/dataset/c72aa453-d1bf-5b11-a133-3cee3e833de1" ;
    dcterms:isPartOf <http://fdp.dcc.sib.swiss/catalog/b865fa92-78f0-59a6-bd27-e03ba9b2517d> ;
    dcterms:issued "2026-02-24T14:27:40"^^xsd:dateTime ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0> ;
    dcterms:modified "2026-02-24T14:27:40"^^xsd:dateTime ;
    dcterms:publisher [ a foaf:Agent ;
            foaf:name "Swiss Personalized Health Network (SPHN)" ] ;
    dcterms:source <https://www.biomedit.ch/rdf/sphn-schema/sphn/individual#Cohort> ;
    dcterms:temporal [ a dcterms:PeriodOfTime ;
            dcat:endDate "2024-12-31"^^xsd:date ;
            dcat:startDate "1993-01-01"^^xsd:date ] ;
    dcterms:title "Clinical gait analysis data for cerebral palsy and toe walking patients" ;
    ns3:SIO_000628 <http://fdp.dcc.sib.swiss/dataset/c72aa453-d1bf-5b11-a133-3cee3e833de1/metrics/445c0a70d1e214e545b261559e2842f4>,
        <http://fdp.dcc.sib.swiss/dataset/c72aa453-d1bf-5b11-a133-3cee3e833de1/metrics/5d27e854a9e78eb3f663331cd47cdc13> ;
    dcat:contactPoint <https://biomedit.ch/rdf/sphn-resource/sphn-metacat-f0519930-ba4e-4742-9845-523625a2c25a> ;
    dcat:distribution <http://fdp.dcc.sib.swiss/distribution/c1bd5d80-086a-5c94-b2fa-4e8ad558ae5d> ;
    dcat:theme <http://publications.europa.eu/resource/authority/data-theme/HEAL>,
        <http://purl.obolibrary.org/obo/NCIT_C154626>,
        <http://purl.obolibrary.org/obo/NCIT_C189005>,
        <http://purl.obolibrary.org/obo/NCIT_C75445> ;
    dcat:version "1.0" ;
    ns1:hasAgeRange "0.6 - 80" ;
    ns1:hasConsentType "General Consent" ;
    ns1:hasDataProvider [ a foaf:Organization ;
            rdfs:label "Universitats-Kinderspital beider Basel" ;
            dcterms:identifier <https://www.uid.admin.ch/Detail.aspx?uid_id=CHE-112.453.018> ;
            foaf:homepage <https://www.ukbb.ch> ],
        [ a foaf:Organization ;
            rdfs:label "Hopitaux universitaires de Geneve" ;
            dcterms:identifier <https://www.uid.admin.ch/Detail.aspx?uid_id=CHE-108.907.884> ;
            foaf:homepage <https://www.hug.ch> ] ;
    ns1:hasDataType "Clinical Routine",
        "Gait Analysis" ;
    ns1:hasDataUseRestriction "The data can be accessed and used by the persons authorized to access the BioMedIT space of the EVIGAITCP project. Other interested parties may contact the project leader (morgan.sangeux@ukbb.ch) to discuss reuse conditions." ;
    ns1:hasExclusionCriteria "A documented refusal from the patient or the legal representative(s) is the main exclusion criteria. In addition, cases with missing or inaccurate data will be excluded." ;
    ns1:hasInclusionCriteria "The project will include all data available from UKBB and HUG, with the following inclusion criteria: male or female, children and adults with a neuromuscular disorder, including cerebral palsy and toe walking. It is important to include the maximum time span for both centres in order to maximise our capacity to assemble treatment and control groups from unicentric and multicentric datasets whenever possible. By control group, we mean the group of patients who did not undergo any treatment between two gait data acquisitions." ;
    ns1:hasNumberOfPatients 3607 ;
    ns1:hasRatioOfSexes "1.46" ;
    ns1:hasStudyType "Retrospective cohort study" ;
    fdp-o:metadataIdentifier <http://fdp.dcc.sib.swiss/dataset/c72aa453-d1bf-5b11-a133-3cee3e833de1#identifier> ;
    fdp-o:metadataIssued "2026-03-03T17:18:09.481640+00:00"^^xsd:dateTime ;
    fdp-o:metadataModified "2026-03-03T17:18:10.579669+00:00"^^xsd:dateTime .


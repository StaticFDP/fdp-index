<http://fdp.dcc.sib.swiss/catalog/727823d9-ab9d-5440-8f0f-78d6d5cecdb0> a dcat:Catalog,
        dcat:Resource ;
    rdfs:label "SwissPedHealth: Development of a multi-omics workflow to discover rare diseases in children with extreme phenotypes - MOMIC" ;
    ns4:applicableLegislation <https://www.fedlex.admin.ch/eli/cc/2013/617/de>,
        <https://www.fedlex.admin.ch/eli/cc/2013/642/de>,
        <https://www.fedlex.admin.ch/eli/cc/2022/491/de> ;
    dcterms:abstract "The identification of underlying genetic and molecular mechanisms is an essential prerequisite for personalized medicine. Building on our preliminary data created in Phase 1, we aim to develop (Phase 2) and test (Phase 3) a Swiss multi-omics workflow to identify rare diseases in children with extreme phenotypes. This will be performed in two further phases. In Phase 2, we will include children from existing cohorts and re-use samples and data to develop novel computational methods to integrate multi-omics data into a diagnostic workflow. This will be based on samples and data with ethical approval already in place. In Phase 3, we will prospectively recruit children with extreme phenotypes from Swiss hospitals to test the multi-omics workflow (done in addition to routine diagnostic procedures) and identify rare diseases causing extreme phenotypes. We will also recruit patient's relatives (healthy parents and siblings) as controls for genomic analysis" ;
    dcterms:accessRights <http://fdp.dcc.sib.swiss/catalog/727823d9-ab9d-5440-8f0f-78d6d5cecdb0#accessRights> ;
    dcterms:conformsTo <http://fdp.dcc.sib.swiss/profile/a0949e72-4466-4d53-8900-9436d1049a4b>,
        <https://www.biomedit.ch/rdf/sphn-schema/sph/2024/1>,
        <https://www.biomedit.ch/rdf/sphn-schema/sph/2025/1> ;
    dcterms:identifier "http://fdp.dcc.sib.swiss/catalog/727823d9-ab9d-5440-8f0f-78d6d5cecdb0" ;

<http://fdp.dcc.sib.swiss/catalog/1bf15715-9973-5288-9d79-74ca5ce4e095> a dcat:Catalog,
        dcat:Resource ;
    rdfs:label "PReparing PERsonalizEd PEdiatRic PRimaRy caRE (PREPP)" ;
    ns5:applicableLegislation <https://www.fedlex.admin.ch/eli/cc/2013/617/de>,
        <https://www.fedlex.admin.ch/eli/cc/2013/642/de>,
        <https://www.fedlex.admin.ch/eli/cc/2022/491/de>,
        "Cantonal data protection laws" ;
    ns3:maxTypicalAge 19 ;
    ns3:minTypicalAge 0 ;
    ns3:numberOfUniqueIndividuals 65998 ;
    dcterms:abstract "The PREPP project aimed to demonstrate the value of integrating paediatric primary care data with the national SwissPedHealth hospital data stream. Operating in pilot sites in Bern, Basel, and Geneva, the project extracted and linked data from primary care databases to hospital Clinical Data Warehouses (CDWs). An essential precondition for linking data from different healthcare providers, was pseudonymising the data through a two-stage hashing process. The project consolidated datasets using existing SPHN infrastructure to provide integrated data for research and public health." ;

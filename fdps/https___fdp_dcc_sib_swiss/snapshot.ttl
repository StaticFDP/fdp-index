        <http://fdp.dcc.sib.swiss/dataset/2f03de29-b60e-536b-9362-389e40fa0585/metrics/5d27e854a9e78eb3f663331cd47cdc13> ;
    dcat:contactPoint <https://biomedit.ch/rdf/sphn-resource/27dbf110-1a48-4f3d-a5e4-59cf113e9ab1>,
        <https://biomedit.ch/rdf/sphn-resource/5c508245-75b7-4ca5-8683-7c02aef34609>,
        <https://biomedit.ch/rdf/sphn-resource/eadff9fb-8709-43ac-8d3c-e3774ee1fab4> ;
    dcat:distribution <http://fdp.dcc.sib.swiss/distribution/7a084478-9f83-56ab-bdeb-100f2a8363ff> ;
    dcat:theme <http://www.ebi.ac.uk/efo/EFO_0004600>,
        <http://www.ebi.ac.uk/efo/EFO_0008479> ;
    dcat:version "1.0" ;
    ns1:hasBiobank [ a foaf:Organization ;
            rdfs:label "CHUV Genomic Biobank" ;
            foaf:homepage <https://www.chuv.ch/fr/consentement-general/cg-home/comprendre/la-biobanque-genomique-du-chuv-bgc> ] ;
    ns1:hasConsentType "General Consent" ;
    ns1:hasDataProvider [ a foaf:Organization ;
            rdfs:label "CHUV Genomic Biobank" ;
            foaf:homepage <https://www.chuv.ch/fr/consentement-general/cg-home/comprendre/la-biobanque-genomique-du-chuv-bgc> ] ;
    ns1:hasDataType "Genomics" ;
    ns1:hasDataUseRestriction "Third parties can apply for reuse. Access is granted upon approval of the project board according to the reuse conditions described in the protocol and respective agreements." ;
    ns1:hasExclusionCriteria "CHUV Genomic Biobank participant's decision to opt out from the GoS-Pilot or incapacity to voluntarily make a decision to participate in the GoS-Pilot",
        "Diagnoses frequently associated with pathogenic genetic variants or chromosomal rearrangements, these include the following ICD-10 diagnose codes: C00-D48, Q00-Q99, D50-D90, patients with rare diseases",
        "Significant overrepresentation of specific diagnoses (e.g. patients with type 2 diabetes) or other features (e.g. younger age) to ensure the GoS-Pilot dataset is agnostic of disease groups or research-specific interests" ;
    ns1:hasInclusionCriteria "Adult CHUV Genomic Biobank participants who have signed general consent and did not opt-out from GoS-Pilot",
        "Biological samples and preanalytical information available to enable expansion towards multiomic analyses",
        "Broadly representing the diversity of the contemporary Swiss population",
        "Genomic DNA samples from blood allowing to address human constitutional genetic variance" ;
    ns1:hasRatioOfSexes "0.495" ;
    ns1:hasStudyType "Infrastructure project - population genomic reference panel" ;

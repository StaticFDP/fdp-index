<http://fdp.dcc.sib.swiss/dataset/36c4522a-d8cf-5168-b08e-25d7e47d47ab> a dcat:Dataset,
        dcat:Resource ;
    rdfs:label "SwissPedHealth Clinical Dataset" ;
    ns4:applicableLegislation <https://www.fedlex.admin.ch/eli/cc/2013/617/de>,
        <https://www.fedlex.admin.ch/eli/cc/2013/642/de>,

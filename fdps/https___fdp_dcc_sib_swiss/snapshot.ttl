<http://fdp.dcc.sib.swiss/catalog/b865fa92-78f0-59a6-bd27-e03ba9b2517d> a dcat:Catalog,
        dcat:Resource ;
    rdfs:label "Getting High Level of Evidence for Surgical Treatments From Routine Clinical Data. A Real-world Testing of the SPHN Infrastructure (EVIGAITCP)" ;
    ns3:applicableLegislation <https://www.fedlex.admin.ch/eli/cc/2013/617/de>,
        <https://www.fedlex.admin.ch/eli/cc/2013/642/de>,
        <https://www.fedlex.admin.ch/eli/cc/2022/491/de>,
        "Cantonal data protection laws" ;
    ns4:maxTypicalAge 80 ;
    ns4:minTypicalAge 6 ;
    ns4:numberOfUniqueIndividuals 3607 ;
    dcterms:abstract "This project aims to leverage existing observational cohort data from multiple centres to improve clinical decision making in persons with neuromuscular disorders, including cerebral palsy and those toe walking. The SPHN infrastructure will be used to merge rich datasets from two pilot centres: the clinical gait analysis services at UKBB and HUG. From this unique combined dataset, the project will determine the best possible treatments to improve walking in persons with neuromuscular disorders, by determining the causal effect of treatments." ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/RESTRICTED> ;
    dcterms:conformsTo <http://fdp.dcc.sib.swiss/profile/a0949e72-4466-4d53-8900-9436d1049a4b>,
        <https://biomedit.ch/rdf/sphn-schema/evigait/2024/1> ;
    dcterms:identifier "http://fdp.dcc.sib.swiss/catalog/b865fa92-78f0-59a6-bd27-e03ba9b2517d" ;
    dcterms:isPartOf <http://fdp.dcc.sib.swiss> ;
    dcterms:issued "2026-09-25T10:33:06.092364+00:00"^^xsd:dateTime ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:modified "2026-09-25T10:33:06.092364+00:00"^^xsd:dateTime ;
    dcterms:publisher [ a foaf:Agent ;
            foaf:name "Swiss Personalized Health Network (SPHN)" ] ;
    dcterms:source <https://www.biomedit.ch/rdf/sphn-schema/sphn/individual#Cohort> ;
    dcterms:temporal [ a dcterms:PeriodOfTime ;
            dcat:endDate "2024-12-31"^^xsd:date ;
            dcat:startDate "1993-01-01"^^xsd:date ] ;
    dcterms:title "Getting High Level of Evidence for Surgical Treatments From Routine Clinical Data. A Real-world Testing of the SPHN Infrastructure (EVIGAITCP)" ;
    ns5:SIO_000628 <http://fdp.dcc.sib.swiss/catalog/b865fa92-78f0-59a6-bd27-e03ba9b2517d/metrics/445c0a70d1e214e545b261559e2842f4>,
        <http://fdp.dcc.sib.swiss/catalog/b865fa92-78f0-59a6-bd27-e03ba9b2517d/metrics/5d27e854a9e78eb3f663331cd47cdc13> ;
    dcat:contactPoint <https://biomedit.ch/rdf/sphn-resource/962a7d05-e2c2-4723-8388-8e37c32baf01> ;
    dcat:dataset <http://fdp.dcc.sib.swiss/dataset/c72aa453-d1bf-5b11-a133-3cee3e833de1> ;
    dcat:themeTaxonomy <http://purl.obolibrary.org/obo/ncit.owl> ;
    dcat:version "1.0" ;
    ns1:hasAcronym "EVIGAITCP" ;
    ns1:hasActivityStatus "INACTIVE" ;
    ns1:hasConsentType "General Consent" ;
    ns1:hasDataProvider [ a foaf:Organization ;
            rdfs:label "Universitats-Kinderspital beider Basel" ;
            dcterms:identifier <https://www.uid.admin.ch/Detail.aspx?uid_id=CHE-112.453.018> ;
            foaf:homepage <https://www.ukbb.ch> ],
        [ a foaf:Organization ;
            rdfs:label "Hopitaux universitaires de Geneve" ;
            dcterms:identifier <https://www.uid.admin.ch/Detail.aspx?uid_id=CHE-108.907.884> ;
            foaf:homepage <https://www.hug.ch> ] ;
    ns1:hasDataType "Clinical Routine",
        "Gait Analysis" ;
    ns1:hasDataUseRestriction "The data can be accessed and used by the persons authorized to access the BioMedIT space of the EVIGAITCP project. Other interested parties may contact the project leader (morgan.sangeux@ukbb.ch) to discuss reuse conditions." ;
    ns1:hasExclusionCriteria "A documented refusal from the patient or the legal representative(s) is the main exclusion criteria. In addition, cases with missing or inaccurate data will be excluded." ;
    ns1:hasFundingOrganization [ a foaf:Organization ;
            rdfs:label "Swiss Personalized Health Network" ;
            foaf:homepage <https://sphn.ch> ] ;
    ns1:hasInclusionCriteria "The project will include all data available from UKBB and HUG, with the following inclusion criteria: male or female, children and adults with a neuromuscular disorder, including cerebral palsy and toe walking. It is important to include the maximum time span for both centres in order to maximise our capacity to assemble treatment and control groups from unicentric and multicentric datasets whenever possible. By control group, we mean the group of patients who did not undergo any treatment between two gait data acquisitions." ;
    ns1:hasPrincipalInvestigator "Dr. Morgan Sangeux" ;
    ns1:hasProjectPartner [ a foaf:Organization ;
            rdfs:label "University of Basel" ;
            foaf:homepage <https://www.unibas.ch> ],
        [ a foaf:Organization ;
            rdfs:label "Universitats-Kinderspital beider Basel" ;
            dcterms:identifier <https://www.uid.admin.ch/Detail.aspx?uid_id=CHE-112.453.018> ;

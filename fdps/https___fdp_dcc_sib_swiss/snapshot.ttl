            foaf:name "Swiss Personalized Health Network (SPHN)" ] ;
    dcterms:source <https://www.biomedit.ch/rdf/sphn-schema/sphn/individual#ResearchLaboratory> ;
    dcterms:title "Phase 2 - Phenotypic Observation Remethylation Disorder" ;

<http://fdp.dcc.sib.swiss/catalog/727823d9-ab9d-5440-8f0f-78d6d5cecdb0> a dcat:Catalog,
        dcat:Resource ;
    rdfs:label "SwissPedHealth: Development of a Multi-omics Workflow to Discover Rare Diseases in Children With Extreme Phenotypes (MOMIC)" ;
    ns3:applicableLegislation <https://www.fedlex.admin.ch/eli/cc/2013/617/de>,
        <https://www.fedlex.admin.ch/eli/cc/2013/642/de>,
        <https://www.fedlex.admin.ch/eli/cc/2022/491/de>,
        "Cantonal data protection laws" ;
    ns4:maxTypicalAge 20 ;
    ns4:minTypicalAge 0 ;
    ns4:numberOfUniqueIndividuals 340 ;
    dcterms:abstract "The identification of underlying genetic and molecular mechanisms is an essential prerequisite for personalized medicine. Building on our preliminary data created in phase 1, we aim to develop (Phase 2) and test (Phase 3) a Swiss multi-omics work-flow to identify rare diseases in children with extreme phenotypes. This will be performed in two further phases. In phase 2, we will include children from existing cohorts and re-use samples and data to develop novel computational methods to integrate multi-omics data into a diagnostic work-flow. This will be based on samples and data with ethical approval already in place. In phase 3, we will prospectively recruit children with extreme phenotypes from Swiss hospitals to test the multi-omics work-flow (done in addition to routine diagnostic procedures) and identify rare diseases causing extreme phenotypes. We will also recruit patient's relatives (healthy parents and siblings) as controls for genomic analysis." ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/NON_PUBLIC> ;
    dcterms:conformsTo <http://fdp.dcc.sib.swiss/profile/a0949e72-4466-4d53-8900-9436d1049a4b>,
        <https://www.biomedit.ch/rdf/sphn-schema/sph/2024/1>,
        <https://www.biomedit.ch/rdf/sphn-schema/sph/2025/1> ;
    dcterms:identifier "http://fdp.dcc.sib.swiss/catalog/727823d9-ab9d-5440-8f0f-78d6d5cecdb0" ;
    dcterms:isPartOf <http://fdp.dcc.sib.swiss> ;
    dcterms:isReferencedBy <https://doi.org/10.1038/s42255-022-00720-8>,
        <https://doi.org/10.1093/bioadv/vbad142>,
        <https://doi.org/10.1136/bmjopen-2024-091884> ;
    dcterms:issued "2026-09-25T10:39:30.771702+00:00"^^xsd:dateTime ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;

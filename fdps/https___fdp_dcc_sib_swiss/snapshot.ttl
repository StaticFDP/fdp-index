            rdfs:label "Ostschweizer Kantonspital" ;
            dcterms:identifier <https://www.uid.admin.ch/Detail.aspx?uid_id=CHE-108.906.206> ;
            foaf:homepage <https://www.h-och.ch> ],
        [ a foaf:Organization ;

    dcterms:conformsTo <http://fdp.dcc.sib.swiss/profile/2f08228e-1789-40f8-84cd-28e3288c3604> ;
    dcterms:description "The dataset comprises the quality check (QC) metadata of the whole genome sequencing (WGS) and bulk RNA sequencing (RNA-seq) from samples collected during the retrospective phase (Phase 2) of the project. These samples were biobanked by the SwissPedHealth Lighthouse Project, and the Lighthouse team prepared the purified materials. Subsequently, the samples were sent to the Health 2030 Genome Center (H2030GC) for processing." ;
    dcterms:identifier "http://fdp.dcc.sib.swiss/dataset/334589be-975f-5e16-b930-0534f463a1d2" ;
    dcterms:isPartOf <http://fdp.dcc.sib.swiss/catalog/727823d9-ab9d-5440-8f0f-78d6d5cecdb0> ;

            foaf:name "Swiss Personalized Health Network (SPHN)" ] ;
    dcterms:source <https://www.biomedit.ch/rdf/sphn-schema/sphn/individual#Biobank> ;
    dcterms:temporal [ a dcterms:PeriodOfTime ;
            dcat:endDate "2024-02-08"^^xsd:date ;
            dcat:startDate "2013-01-25"^^xsd:date ] ;

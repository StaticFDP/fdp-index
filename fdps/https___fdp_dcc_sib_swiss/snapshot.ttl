        "Cantonal data protection laws" ;
    ns2:hasCodingSystem <https://atcddd.fhi.no/atc_ddd_index>,
        <https://browser.ihtsdotools.org/?perspective=full&conceptId1=404684003&edition=MAIN/SNOMEDCT-CH/2025-06-07>,
        <https://loinc.org>,
        <https://ncithesaurus.nci.nih.gov>,
        <https://obofoundry.org/ontology/eco.html>,
        <https://obofoundry.org/ontology/hp.html>,
        <https://obofoundry.org/ontology/xco.html>,
        <https://ucum.org>,
        <https://www.bfarm.de/EN/Code-systems/Classifications/ICD/ICD-O-3/_node.html>,
        <https://www.bfs.admin.ch/bfs/de/home/statistiken/kataloge-datenbanken.assetdetail.36016195.html>,
        <https://www.bfs.admin.ch/news/de/2024-0148> ;
    ns2:hdab [ a foaf:Agent ;
            foaf:mbox "luregn.schlapbach@kispi.uzh.ch" ;
            foaf:name "SPH Consortium" ] ;
    ns2:healthCategory <https://biomedit.ch/rdf/sphn-metacat/sphn/health-category/DFIH>,
        <https://biomedit.ch/rdf/sphn-metacat/sphn/health-category/EHRD>,
        <https://biomedit.ch/rdf/sphn-metacat/sphn/health-category/HRAD> ;
    ns2:maxTypicalAge 20 ;
    ns2:minTypicalAge 0 ;
    ns2:numberOfRecords 761339 ;
    ns2:numberOfUniqueIndividuals 761339 ;
    dcterms:accessRights <http://publications.europa.eu/resource/authority/access-right/RESTRICTED> ;
    dcterms:conformsTo <http://fdp.dcc.sib.swiss/profile/2f08228e-1789-40f8-84cd-28e3288c3604>,
        <https://www.biomedit.ch/rdf/sphn-schema/sph/2025/1>,
        <https://www.biomedit.ch/rdf/sphn-schema/sphn/2024/2>,
        <https://www.biomedit.ch/rdf/sphn-schema/sphn/2025/1> ;
    dcterms:description "Due to the unique epidemiology, developmental changes, and high vulnerability of children, there is an urgent need to continuously improve health care based on real world pediatric data. The digital transformation is a unique opportunity to shape a data-driven, agile, learning health care system and deliver more efficient and personalized care to children and their families.  The goal of SwissPedHealth is to build a sustainable and scalable infrastructure to make routine clinical data from pediatric hospitals in Switzerland interoperable, standardized, quality-controlled, and ready for observational research, quality assurance, trials, and health-policy creation. SwissPedHealth is one of four National Data Streams co-funded by the Swiss Personalized Health Network (SPHN) and the ETH focus area Personalized Health Related Technologies (PHRT). Dedicated catalog and dataset are provided for PHRT data. SwissPedHealth develops modular governance and regulatory strategies in collaboration with clinical data warehouses, the Data Coordination Center, Biomedical Information Technology Network, and others." ;
    dcterms:identifier "http://fdp.dcc.sib.swiss/dataset/36c4522a-d8cf-5168-b08e-25d7e47d47ab" ;
    dcterms:isPartOf <http://fdp.dcc.sib.swiss/catalog/86fb83e6-27ae-55f4-9b57-6fdeb97b719b> ;
    dcterms:issued "2026-04-19T16:00:21"^^xsd:dateTime ;
    dcterms:language <http://id.loc.gov/vocabulary/iso639-1/en> ;
    dcterms:modified "2026-04-19T16:00:21"^^xsd:dateTime ;
    dcterms:publisher [ a foaf:Agent ;
            foaf:name "Swiss Personalized Health Network (SPHN)" ] ;
    dcterms:source <https://www.biomedit.ch/rdf/sphn-schema/sphn/individual#ClinicalDataPlatform>,
        <https://www.biomedit.ch/rdf/sphn-schema/sphn/individual#HealthcareInformationSystem> ;
    dcterms:temporal [ a dcterms:PeriodOfTime ;
            dcat:endDate "2025-12-31"^^xsd:date ;
            dcat:startDate "2017-01-01"^^xsd:date ] ;
    dcterms:title "SwissPedHealth Clinical Dataset" ;
    ns3:SIO_000628 <http://fdp.dcc.sib.swiss/dataset/36c4522a-d8cf-5168-b08e-25d7e47d47ab/metrics/445c0a70d1e214e545b261559e2842f4>,

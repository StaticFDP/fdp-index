<https://raw.githubusercontent.com/Koetai/biodiversity-fdp/main/fdp/flair-gg-fdp/catalog> a dcat:Catalog ;
    dcterms:description "FLAIR-GG makes seed and germplasm banks FAIR without changing their databases: each bank exports CSV templates, YARRRML turns them into RDF following a shared semantic model (germplasm, location, administrative), and each bank runs its own FAIR Data Point and SPARQL endpoints. A Virtual Platform federates queries across all members. Six banks are live; this catalog lists every way to reach them."@en ;
    dcterms:publisher <https://raw.githubusercontent.com/Koetai/biodiversity-fdp/main/fdp/flair-gg-fdp/publisher-flairgg> ;
    dcterms:rights <https://wilkinsonlab.github.io/FLAIR-GG/> ;
    dcterms:title "FLAIR-GG — FAIR network of Spanish plant germplasm banks"@en ;
    dcat:dataset <https://raw.githubusercontent.com/Koetai/biodiversity-fdp/main/fdp/flair-gg-fdp/bgusal-2025-02>,
        <https://raw.githubusercontent.com/Koetai/biodiversity-fdp/main/fdp/flair-gg-fdp/bgv-2023-06>,
        <https://raw.githubusercontent.com/Koetai/biodiversity-fdp/main/fdp/flair-gg-fdp/jbclm-2025-10>,
        <https://raw.githubusercontent.com/Koetai/biodiversity-fdp/main/fdp/flair-gg-fdp/jbo-2024-08>,
        <https://raw.githubusercontent.com/Koetai/biodiversity-fdp/main/fdp/flair-gg-fdp/jbs-2025-02>,
        <https://raw.githubusercontent.com/Koetai/biodiversity-fdp/main/fdp/flair-gg-fdp/semantic-model>,
        <https://raw.githubusercontent.com/Koetai/biodiversity-fdp/main/fdp/flair-gg-fdp/urjc-2024-11>,
        <https://raw.githubusercontent.com/Koetai/biodiversity-fdp/main/fdp/flair-gg-fdp/virtual-platform>,
        <https://raw.githubusercontent.com/Koetai/biodiversity-fdp/main/fdp/flair-gg-fdp/wfo-backbone> ;
    dcat:keyword "FAIR Data Point"@en,
        "Spain"@en,
        "ex situ conservation"@en,
        "germplasm"@en,
        "seed bank"@en,
        "wild flora"@en ;
    dcat:landingPage <https://wilkinsonlab.github.io/FLAIR-GG/> .


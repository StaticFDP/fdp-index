    prov:wasDerivedFrom <https://raw.githubusercontent.com/Koetai/biodiversity-fdp/main/fdp/gbif-fdp/gbif-occurrence-live> .

<https://raw.githubusercontent.com/Koetai/biodiversity-fdp/main/fdp/gbif-fdp/dist-live-sql> a dcat:Distribution ;
    dcterms:description "How to get it: POST an SQL query (SELECT / WHERE / GROUP BY over the occurrence table) to the download API with format SQL_TSV_ZIP; result arrives as a zipped TSV with DOI. Good for gridded counts and cubes."@en ;
    dcterms:format <http://publications.europa.eu/resource/authority/file-type/ZIP> ;
    dcterms:title "GBIF SQL download API"@en ;

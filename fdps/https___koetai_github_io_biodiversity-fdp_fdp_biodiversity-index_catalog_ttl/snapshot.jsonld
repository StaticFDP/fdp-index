    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "FLAIR-GG makes seed and germplasm banks FAIR without changing their databases: each bank exports CSV templates, YARRRML turns them into RDF following a shared semantic model (germplasm, location, administrative), and each bank runs its own FAIR Data Point and SPARQL endpoints. A Virtual Platform federates queries across all members. Six banks are live; this catalog lists every way to reach them."
      }
    ],
    "http://purl.org/dc/terms/publisher": [
      {
        "@id": "https://raw.githubusercontent.com/Koetai/biodiversity-fdp/main/fdp/flair-gg-fdp/publisher-flairgg"
